        snowy_days=snowy_days,
        start_date=start_date,
        end_date=end_date,
        mode="merged"
    )
    
    print("✅ 2 FIGS: Sensors Raw | Means Clean")




def _plot_cml_signal(ax, df_cml_dict, window_start, window_end, event_day=None, 
                     signal_type='attenuation', event_color='red', df_cml_meta=None, 
                     emphasize_cml_ids=None, resample_interval=None,
                     linewidth=2.5, linewidth_emphasized=4.0):
    """Plot CML signal (RSL or attenuation)."""
    colors = plt.cm.tab10(np.linspace(0, 1, min(len(df_cml_dict), 10)))
    
    emphasize_set = set()
    if emphasize_cml_ids is not None:
        emphasize_set = {str(cid) for cid in emphasize_cml_ids}
    
    plotted_count = 0
    for i, (cml_key, df) in enumerate(df_cml_dict.items()):
        if df is None or df.empty:
            continue
        if signal_type not in df.columns:
            continue
        
        data = df.loc[window_start:window_end, signal_type]
        if data.empty or data.isna().all():
            continue
        
        if resample_interval is not None and len(data) > 0:
            data = data.resample(resample_interval).mean()
        
        if len(data) > 0:
            # Parse cml_key: format is "{cml_id}_{sublink_idx}" e.g. "1_2"
            parts = cml_key.split('_')
            cml_id_str = parts[0]
            sublink_idx = int(parts[1]) if len(parts) > 1 else 0  # 1-based index in key
            is_emphasized = cml_id_str in emphasize_set
            
            # Build label using BOTH cml_id AND sublink_id from metadata
            label = cml_key  # fallback
            if df_cml_meta is not None:
                # sublink_id in metadata is "sublink_1", "sublink_2", etc.
                # cml_key "1_2" means cml_id=1, sublink index=2 → "sublink_2"
                sublink_id_str = f'sublink_{sublink_idx}'
                
                # Look up the exact row matching both cml_id AND sublink_id
                mask = (df_cml_meta['cml_id'].astype(str) == cml_id_str)
                if 'sublink_id' in df_cml_meta.columns:
                    mask = mask & (df_cml_meta['sublink_id'] == sublink_id_str)
                
                cml_row = df_cml_meta[mask]
                
                if len(cml_row) > 0:
                    row = cml_row.iloc[0]
                    freq = row.get('frequency', None)
                    length = row.get('length', None)
                    sublink_label = sublink_id_str.replace('sublink_', 'SL')
                    
                    if freq is not None and length is not None and \
                       not (isinstance(freq, float) and np.isnan(freq)) and \
                       not (isinstance(length, float) and np.isnan(length)):
                        
                        # Format length
                        if length >= 1000:
                            length_str = f'{length/1000:.1f}km'
                        else:
                            length_str = f'{length:.0f}m'
                        
                        # Format frequency
                        if freq >= 1000:
                            freq_str = f'{freq/1000:.1f}GHz'
                        else:
                            freq_str = f'{freq:.0f}MHz'
                        
                        # Label: "CML1-SL2 | 68.0GHz 2.2km"
                        label = f'CML{cml_id_str}-{sublink_label} | {freq_str} {length_str}'
                    else:
                        label = f'CML{cml_id_str}-{sublink_label}'
            
            # Color and linewidth
            if is_emphasized:
                plot_color = 'cyan'
                lw = linewidth_emphasized
                alpha = 0.95
            else:
                plot_color = colors[i % 10]
                lw = linewidth
                alpha = 0.85
            
            ax.plot(data.index, data.values, lw=lw, alpha=alpha, 
                   color=plot_color, label=label if plotted_count < 10 else None)
            plotted_count += 1
    
    if event_day is not None:
        ax.axvspan(event_day, event_day + pd.Timedelta(days=1), alpha=0.06, color=event_color)
    
    ax.axhline(0, color='k', lw=0.5, alpha=0.8)
    ylabel = 'Attenuation (dB)' if signal_type == 'attenuation' else 'RSL (dBm)'
    ax.set_ylabel(ylabel, fontweight='bold', fontsize=15)
    ax.set_title(f'CML {signal_type.upper()}', fontweight='bold', loc='left', fontsize=16)
    ax.grid(True, alpha=0.25, linewidth=0.5)
    if plotted_count <= 10:
        ax.legend(loc='upper right', fontsize=12, ncol=2)



def _plot_snow_depth(ax, snow_depth_data, window_start, window_end, event_day, 
                     station='BKLN', snow_data=None, event_color='red'):
    """Plot snow depth with stats."""
    
    mesonet = snow_depth_data.get('mesonet')
    if mesonet is not None and station in mesonet.columns:
        data = mesonet[station].loc[window_start:window_end]
        if len(data) > 0:
            ax.plot(data.index, data.values, lw=2, color='#1f77b4', 
                   marker='o', markersize=2, label='Mesonet')
    
    ax.axvspan(event_day, event_day + pd.Timedelta(days=1), alpha=0.15, color=event_color)
    ax.axhline(0, color='k', lw=0.5, alpha=0.8)
    
    # Stats box
    stats = _get_day_stats(event_day, snow_depth_data, snow_data, station)
    if stats:
        ax.text(0.02, 0.98, '\n'.join(stats), transform=ax.transAxes, fontsize=9,
                va='top', bbox=dict(boxstyle='round', facecolor='lightblue', alpha=0.8))
    
    ax.set_ylabel('Snow Depth (mm)', fontweight='bold')
    ax.set_title(f'Snow Depth ({station})', fontweight='bold', loc='left')
    ax.grid(True, alpha=0.8)
    ax.legend(loc='upper right', fontsize=9)


