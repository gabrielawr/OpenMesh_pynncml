    all_params,
    event_type='snow',
    signal_type='attenuation',
    station='BKLN',
    window_days=1,
    max_events=None,
    precip_mode='all',
    figsize=None,
    cml_to_pws_map=None,
    df_cml_meta=None,
    emphasize_cml_ids=None
):
    """
    Unified event day analysis plot.
    
    Subplot order:
        1. CML Signal
        2. PWS Precipitation (NEW position)
        3. Precip Type (ASOS)
        4. Snow Depth (snow events only)
        5. Temperature
        6. Official Precipitation
    
    Parameters
    ----------
    emphasize_cml_ids : list, optional
        List of CML IDs to emphasize with cyan color and thicker line.
        Can be strings or integers. Example: [20, 25] or ['20', '25']
    """
    
    event_days = pd.to_datetime(event_days)
    if max_events:
        event_days = event_days[:max_events]
    
    # Event-specific settings
    event_config = {
        'snow': {'color': 'red', 'emoji': '❄️', 'show_snow_depth': True},
        'rain': {'color': 'blue', 'emoji': '🌧️', 'show_snow_depth': False},
        'custom': {'color': 'gray', 'emoji': '📅', 'show_snow_depth': False},
    }
    config = event_config.get(event_type, event_config['custom'])
    
    # Determine number of rows
    # Base: CML, PWS, Ptype, Temp, Precip = 5
    n_rows = 5
    if config['show_snow_depth']:
        n_rows += 1
    
    if figsize is None:
        figsize = (18, 3.5 * n_rows)
    
    # Extract data
    ptype_data = all_params.get('precip_type', {})
    snow_data = all_params.get('snow', {})
    snow_depth_data = all_params.get('snow_depth', {})
    temp_data = all_params.get('temp', {})
    precip_data = all_params.get('precip', {})
    
    # Extract CML IDs from df_cml_dict and get relevant PWS stations
    pws_stations = None
    if cml_to_pws_map is not None:
        # Extract unique CML IDs from df_cml_dict keys (format: "cml_id_sublink_idx")
        cml_ids = set()
        for key in df_cml_dict.keys():
            cml_id = str(key.split('_')[0])  # Extract CML ID from "cml_id_sublink_idx"
            cml_ids.add(cml_id)
        
        # Collect all PWS stations matched to these CML IDs
        relevant_pws = set()
        for cml_id in cml_ids:
            # Try both string and int keys
            if cml_id in cml_to_pws_map:
                matches = cml_to_pws_map[cml_id]
            elif int(cml_id) in cml_to_pws_map:
                matches = cml_to_pws_map[int(cml_id)]
            else:
                continue
            
            if isinstance(matches, pd.DataFrame) and 'station_id' in matches.columns:
                relevant_pws.update(matches['station_id'].tolist())
        
        if len(relevant_pws) > 0:
            pws_stations = list(relevant_pws)
            print(f"✓ Filtering PWS to {len(pws_stations)} stations matched to {len(cml_ids)} CML links")
    
    for event_day in event_days:
        w_start = event_day - pd.Timedelta(days=window_days)
        w_end = event_day + pd.Timedelta(days=window_days + 1)
        
        fig, axes = plt.subplots(n_rows, 1, figsize=figsize, sharex=True)
        ax_idx = 0
        
        # Row 1: CML Signal
        _plot_cml_signal(axes[ax_idx], df_cml_dict, w_start, w_end, event_day, 
                        signal_type, config['color'], df_cml_meta=df_cml_meta,
                        emphasize_cml_ids=emphasize_cml_ids)
        ax_idx += 1
        
        # Row 2: PWS Precipitation (NEW position)
        _plot_precip(axes[ax_idx], precip_data, w_start, w_end, event_day,
                    station, 'pws', config['color'], pws_stations=pws_stations)
        ax_idx += 1
        
        # Row 3: Precip Type (ASOS)
        _plot_precip_type(axes[ax_idx], ptype_data, w_start, w_end, event_day,
                         config['color'])
        ax_idx += 1
        
        # Row 4: Snow Depth (only for snow events)
        if config['show_snow_depth']:
            _plot_snow_depth(axes[ax_idx], snow_depth_data, w_start, w_end, event_day,
                           station, snow_data, config['color'])
            ax_idx += 1
        
        # Row 5: Temperature
        _plot_temperature(axes[ax_idx], temp_data, w_start, w_end, event_day, config['color'])
        ax_idx += 1
        
        # Row 6: Official Precipitation (NOAA/Mesonet/ASOS)
        _plot_precip(axes[ax_idx], precip_data, w_start, w_end, event_day,
                    station, 'official', config['color'])
        
        # Format x-axis
        axes[-1].set_xlabel('Time', fontweight='bold')
        axes[-1].xaxis.set_major_formatter(mdates.DateFormatter('%m-%d %H:%M'))
        plt.setp(axes[-1].xaxis.get_majorticklabels(), rotation=45, ha='right')
        
        # Title
        title = f'{config["emoji"]} {event_type.title()} Day Analysis - {event_day.strftime("%B %d, %Y (%A)")}'
        fig.suptitle(title, fontsize=14, fontweight='bold')
        plt.tight_layout()
        plt.show()
        
        print(f"✓ {event_day.strftime('%Y-%m-%d')}")
def plot_cml_sensor_matching(
    df_cml_meta, 
    cml_to_sensor_maps=None,
    cml_ids=None, 
    sensor_types=None,
    n_cmls=5, 
    base_path=None, 
    figsize=(14, 12),
    show_distance_for=['PWS'],  # Only show distance labels for these
    debug=False
):
    """
    Plot selected CMls with their matched sensors, showing distances.
    
    Parameters
    ----------
    df_cml_meta : pd.DataFrame
        CML metadata with site_0_lat, site_0_lon, site_1_lat, site_1_lon
    cml_to_sensor_maps : dict
        {sensor_type: cml_to_sensor_map} 
        e.g., {'PWS': cml_to_pws_map, 'ASOS': cml_to_asos_map, 'Mesonet': cml_to_mesonet_map}
    cml_ids : list, optional
        Specific CML IDs to plot. If None, randomly select n_cmls.
    sensor_types : list, optional
        Which sensor types to plot. If None, plots all in cml_to_sensor_maps.
    n_cmls : int
        Number of CMls to show if cml_ids not specified
    base_path : Path
        For NYC boundary shapefile
    show_distance_for : list
        Only show distance labels for these sensor types (default: ['PWS'])
    debug : bool
        Print debug info
        
    Example
    -------
    >>> plot_cml_sensor_matching(
    ...     df_cml_meta,
    ...     cml_to_sensor_maps={
    ...         'PWS': cml_to_pws_map,
    ...         'ASOS': cml_to_asos_map,
    ...         'Mesonet': cml_to_mesonet_map
    ...     },
    ...     cml_ids=selected_cml_ids
    ... )
    """
    
    if cml_to_sensor_maps is None:
        print("⚠ No cml_to_sensor_maps provided!")
        return None
    
    # Determine which sensor types to plot
    if sensor_types is None:
        sensor_types = list(cml_to_sensor_maps.keys())
    
    if len(sensor_types) == 0:
        print("⚠ No sensor types to plot")
        return None
    
    if debug:
        print(f"DEBUG: sensor_types to plot: {sensor_types}")
        for st in sensor_types:
            if st in cml_to_sensor_maps:
                map_keys = list(cml_to_sensor_maps[st].keys())[:5]
                print(f"  {st} map has {len(cml_to_sensor_maps[st])} CMLs, first keys: {map_keys}")
                if len(map_keys) > 0:
                    print(f"    Key type: {type(map_keys[0])}")
    
    # Sensor type styling - different markers and colors per type
    sensor_styles = {
        'PWS': {'marker': 'o', 'size': 50, 'color': 'purple', 'alpha': 0.7},
        'ASOS': {'marker': '^', 'size': 90, 'color': 'red', 'alpha': 0.9},
        'Mesonet': {'marker': 'D', 'size': 70, 'color': 'green', 'alpha': 0.9},
        'NOAA': {'marker': 'p', 'size': 80, 'color': 'orange', 'alpha': 0.9},
    }
    
    # Select CMls
    if cml_ids is None:
        all_cml_ids_in_maps = set()
        for sensor_type in sensor_types:
            if sensor_type in cml_to_sensor_maps:
                all_cml_ids_in_maps.update(cml_to_sensor_maps[sensor_type].keys())
        
        available = list(all_cml_ids_in_maps)
        if len(available) == 0:
            available = df_cml_meta['cml_id'].astype(str).tolist()
        
        if len(available) == 0:
            print("⚠ No CML IDs found")
            return None
        
        n_select = min(n_cmls, len(available)) if n_cmls else len(available)
        cml_ids = list(np.random.choice(available, size=n_select, replace=False))
    
    if debug:
        print(f"DEBUG: cml_ids to plot: {cml_ids}")
    
    fig, ax = plt.subplots(figsize=figsize)
    
    # Plot NYC boundary if available
    if base_path:
        try:
            import geopandas as gpd
            nyc_shp = base_path / "gis" / "NYC_boundary" / "nyc_boundary.shp"
            if nyc_shp.exists():
                nyc = gpd.read_file(nyc_shp)
                nyc.boundary.plot(ax=ax, color='gray', linewidth=1, alpha=0.5)
        except Exception as e:
            if debug:
                print(f"DEBUG: Could not load NYC boundary: {e}")
    
    # Track plotted sensors
    plotted_sensors = {st: set() for st in sensor_types}
    
    # Detect CML coordinate columns
    if 'site_0_lon' in df_cml_meta.columns:
        lon_a_col, lat_a_col = 'site_0_lon', 'site_0_lat'
        lon_b_col, lat_b_col = 'site_1_lon', 'site_1_lat'
    elif 'site_a_longitude' in df_cml_meta.columns:
        lon_a_col, lat_a_col = 'site_a_longitude', 'site_a_latitude'
        lon_b_col, lat_b_col = 'site_b_longitude', 'site_b_latitude'
    else:
        print(f"⚠ Unknown CML coordinate columns: {df_cml_meta.columns.tolist()}")
        return None
    
    # Track bounds for auto-zoom
    all_lons, all_lats = [], []
    
    # Color map for CMls
    cmap = plt.cm.tab10
    cml_colors = {str(cid): cmap(i % 10) for i, cid in enumerate(cml_ids)}
    
    # Plot each CML
    for cml_id in cml_ids:
        cml_id_str = str(cml_id)
        cml_color = cml_colors[cml_id_str]
        
        # Get CML location
        cml_row = df_cml_meta[df_cml_meta['cml_id'].astype(str) == cml_id_str]
        if len(cml_row) == 0:
            if debug:
                print(f"DEBUG: CML {cml_id} not found in metadata")
            continue
        cml_row = cml_row.iloc[0]
        
        # CML endpoints
        lon_a, lat_a = cml_row[lon_a_col], cml_row[lat_a_col]
        lon_b, lat_b = cml_row[lon_b_col], cml_row[lat_b_col]
        cml_lon, cml_lat = (lon_a + lon_b) / 2, (lat_a + lat_b) / 2
        
        all_lons.extend([lon_a, lon_b])
        all_lats.extend([lat_a, lat_b])
        
        # Plot CML line
        ax.plot([lon_a, lon_b], [lat_a, lat_b], color=cml_color, linewidth=4, 
                solid_capstyle='round', zorder=5, label=f'CML {cml_id}' if len(cml_ids) <= 5 else None)
        ax.scatter(cml_lon, cml_lat, color=cml_color, s=120, marker='s', 
                   edgecolor='black', linewidth=1.5, zorder=6)
        
        # Plot matched sensors for each sensor type
        for sensor_type in sensor_types:
            if sensor_type not in cml_to_sensor_maps:
                continue
            
            sensor_map = cml_to_sensor_maps[sensor_type]
            style = sensor_styles.get(sensor_type, {'marker': 'o', 'size': 60, 'color': 'gray', 'alpha': 0.8})
            
            # Try different key types
            matches_df = sensor_map.get(cml_id_str)
            if matches_df is None:
                matches_df = sensor_map.get(cml_id)
            if matches_df is None:
                try:
                    matches_df = sensor_map.get(int(cml_id))
                except:
                    pass
            
            if matches_df is None or (isinstance(matches_df, pd.DataFrame) and matches_df.empty):
                if debug:
                    print(f"DEBUG: No {sensor_type} matches for CML {cml_id}")
                continue
            
            if debug:
                print(f"DEBUG: CML {cml_id} has {len(matches_df)} {sensor_type} matches")
            
            # Plot each matched sensor
            for _, match_row in matches_df.iterrows():
                sensor_id = match_row.get('station_id', match_row.get('station', 'unknown'))
                distance_m = match_row.get('distance_m', 0)
                distance_km = distance_m / 1000
                
                s_lat = match_row.get('latitude', match_row.get('lat', None))
                s_lon = match_row.get('longitude', match_row.get('lon', None))
                
                if s_lat is None or s_lon is None:
                    if debug:
                        print(f"DEBUG: Missing lat/lon for sensor {sensor_id}")
                    continue
                
                all_lons.append(s_lon)
                all_lats.append(s_lat)
                
                # Draw connection line (dashed)
                ax.plot([cml_lon, s_lon], [cml_lat, s_lat], 
                        color=style['color'], linestyle='--', linewidth=1, alpha=0.4, zorder=3)
                
                # Plot sensor marker (only once per sensor)
                if sensor_id not in plotted_sensors[sensor_type]:
                    ax.scatter(s_lon, s_lat, 
                               color=style['color'], 
                               s=style['size'], 
                               marker=style['marker'],
                               edgecolor='black', linewidth=0.8, 
                               zorder=4, alpha=style['alpha'])
                    plotted_sensors[sensor_type].add(sensor_id)
                
                # Distance label - ONLY for specified sensor types
                if sensor_type in show_distance_for:
                    mid_lon, mid_lat = (cml_lon + s_lon) / 2, (cml_lat + s_lat) / 2
                    ax.annotate(f'{distance_km:.1f}km', (mid_lon, mid_lat), fontsize=7,
                                color=style['color'], alpha=0.9, ha='center',
                                bbox=dict(boxstyle='round,pad=0.2', facecolor='white', alpha=0.6))
    
    # Auto-zoom to data extent with padding
    if len(all_lons) > 0:
        pad = 0.01
        ax.set_xlim(min(all_lons) - pad, max(all_lons) + pad)
        ax.set_ylim(min(all_lats) - pad, max(all_lats) + pad)
    
    # Build legend
    from matplotlib.lines import Line2D
    legend_elements = [
        Line2D([0], [0], color='gray', linewidth=4, label='CML Link'),
        Line2D([0], [0], marker='s', color='gray', markersize=10, 
               linestyle='None', markeredgecolor='black', label='CML Midpoint'),
    ]
    
    # Add sensor type markers to legend
    for sensor_type in sensor_types:
        n_sensors = len(plotted_sensors.get(sensor_type, set()))
        if n_sensors > 0:
            style = sensor_styles.get(sensor_type, {'marker': 'o', 'color': 'gray'})
            legend_elements.append(
                Line2D([0], [0], marker=style['marker'], color=style['color'], 
                       markersize=10, linestyle='None', markeredgecolor='black',
                       label=f'{sensor_type} ({n_sensors})')
            )
    
    ax.legend(handles=legend_elements, loc='upper right', fontsize=10)
    
    # Summary
    total_sensors = sum(len(s) for s in plotted_sensors.values())
    sensor_summary = ', '.join([f'{len(plotted_sensors.get(st, set()))} {st}' for st in sensor_types])
    
    ax.set_xlabel('Longitude', fontsize=12)
    ax.set_ylabel('Latitude', fontsize=12)
    ax.set_title(f'CML to Sensor Matching\n{len(cml_ids)} CMls → {sensor_summary}', 
                 fontsize=14, fontweight='bold')
    ax.grid(True, alpha=0.3)
    ax.set_aspect('equal')
    
    plt.tight_layout()
    plt.show()
    
    print(f"✓ Plotted {len(cml_ids)} CMls with {total_sensors} sensors ({sensor_summary})")
    
    return fig

"""
Enhanced CML Event Day Analysis Plotting Module

Features:
1. Time-limited plots (start_dt, end_dt) - no event day grid needed
2. Merged precipitation panel ('pcpn_merged') - PWS + Official in one panel
3. Flexible panel selection via `panels` parameter
4. Time aggregation (aggregate='15min', '30min', '1H', etc.)
5. Configurable line thickness for CML signals
6. Day grid toggle (day_grid=True/False)

Usage Examples:
--------------
# Standard daily event plot
plot_event_day_analysis(df_cml_dict, event_days, all_params, panels='all')

# Single day (note: must be a list)
plot_event_day_analysis(df_cml_dict, [snowy_days[0]], all_params, panels=['cml', 'pcpn_merged'])

# Time aggregation (15-min averages)
plot_event_day_analysis(df_cml_dict, event_days, all_params, aggregate='15min')
"""

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib.dates as mdates
from matplotlib.patches import Patch
from matplotlib.lines import Line2D
from scipy.interpolate import interp1d


# ============================================================================
# POWER-LAW (ITU-R P.838-3) FUNCTIONS
# ============================================================================

# ITU-R P.838-3 (2005) table: [freq_GHz, k_H, k_V, alpha_H, alpha_V]
_ITU_TABLE_2005 = np.array([
    [1.0, 2.0, 4.0, 6.0, 7.0, 8.0, 10.0, 12.0, 15.0, 20.0, 25.0, 30.0, 35.0, 40.0,
     45.0, 50.0, 60.0, 70.0, 80.0, 90.0, 100.0],
    [0.0000387, 0.000154, 0.00065, 0.00175, 0.00301, 0.00454, 0.0101, 0.0188, 0.0367,
     0.0751, 0.124, 0.187, 0.263, 0.350, 0.442, 0.536, 0.707, 0.851, 0.975, 1.06, 1.12],
    [0.0000352, 0.000138, 0.00063, 0.00155, 0.00265, 0.00395, 0.00887, 0.0168, 0.0335,
     0.0691, 0.113, 0.167, 0.233, 0.310, 0.393, 0.479, 0.642, 0.784, 0.906, 0.999, 1.06],
    [0.912, 0.963, 1.121, 1.308, 1.332, 1.327, 1.276, 1.217, 1.154, 1.099, 1.061,
     1.021, 0.979, 0.939, 0.903, 0.873, 0.826, 0.793, 0.769, 0.753, 0.743],
    [0.880, 0.923, 1.075, 1.265, 1.312, 1.310, 1.264, 1.200, 1.128, 1.065, 1.030,
     1.000, 0.963, 0.929, 0.897, 0.868, 0.824, 0.793, 0.769, 0.754, 0.744]
])


def _calc_a_b_from_frequency(f_GHz, pol='H'):
    """
    Get power-law parameters (a, b) from frequency using ITU-R P.838-3.
    
    Parameters
    ----------
    f_GHz : float
        Frequency in GHz
    pol : str
        'H' or 'V'
    
    Returns
    -------
    a, b : float
    """
    f_GHz = float(f_GHz)
    interp_a_h = interp1d(_ITU_TABLE_2005[0], _ITU_TABLE_2005[1], kind='cubic')
    interp_b_h = interp1d(_ITU_TABLE_2005[0], _ITU_TABLE_2005[3], kind='cubic')
    interp_a_v = interp1d(_ITU_TABLE_2005[0], _ITU_TABLE_2005[2], kind='cubic')
    interp_b_v = interp1d(_ITU_TABLE_2005[0], _ITU_TABLE_2005[4], kind='cubic')

    if pol.upper() in ('H', 'HORIZONTAL'):
        return float(interp_a_h(f_GHz)), float(interp_b_h(f_GHz))
    elif pol.upper() in ('V', 'VERTICAL'):
        return float(interp_a_v(f_GHz)), float(interp_b_v(f_GHz))
    else:
        raise ValueError(f"Invalid polarization: {pol}")


def _calc_R_from_A(A, L_km, a, b, R_min=0.1):
    """
    Rain rate from path-integrated attenuation: R = (A / (a * L))^(1/b).
    
    Parameters
    ----------
    A : array-like
        Attenuation (dB)
    L_km : float
        Link length in km
    a, b : float
        Power-law parameters
    R_min : float
        Values below this are set to 0
    
    Returns
    -------
    R : ndarray  (mm/h)
    """
    A = np.atleast_1d(np.asarray(A, dtype=float))
    R = np.zeros_like(A)
    valid = np.isfinite(A) & (A > 0) & (a > 0) & (L_km > 0)
    R[valid] = (A[valid] / (a * L_km)) ** (1.0 / b)
    R[R < R_min] = 0.0
    R[~np.isfinite(A)] = np.nan
    return R


def _get_power_law_params_for_cmls(df_cml_dict, df_cml_meta):
    """
    Extract power-law parameters (a, b, L_km) for each CML from metadata.
    
    Returns
    -------
    dict : {cml_key: {'a': float, 'b': float, 'L_km': float, 'f_GHz': float}}
    """
    params = {}
    for cml_key in df_cml_dict:
        cml_id_str = str(cml_key.split('_')[0])
        cml_row = df_cml_meta[df_cml_meta['cml_id'].astype(str) == cml_id_str]
        if len(cml_row) == 0:
            continue
        row = cml_row.iloc[0]
        freq = row.get('frequency', None)
        length = row.get('length', None)
        pol = row.get('polarization', 'H')
        if pol is None or (isinstance(pol, float) and np.isnan(pol)):
            pol = 'H'
        if freq is None or length is None:
            continue
        if np.isnan(freq) or np.isnan(length):
            continue
        f_GHz = freq / 1000.0 if freq > 200 else freq  # MHz → GHz if needed
        L_km = length / 1000.0 if length > 100 else length  # m → km if needed
        try:
            a, b = _calc_a_b_from_frequency(f_GHz, str(pol))
        except Exception:
            continue
        params[cml_key] = {'a': a, 'b': b, 'L_km': L_km, 'f_GHz': f_GHz}
    return params


# ============================================================================
# UNIFIED RESAMPLING: resample_all()
# ============================================================================
def resample_all(
    all_params,
    df_cml_dict,
    df_cml_meta=None,
    interval='5min',
    signal_type='attenuation',
    cml_to_pws_map=None,
    R_min=0.01,
):
    """
    Resample ALL data sources to a common time grid.
    
    Returns a single aligned_data dict with weather + CML on the same index,
    clear units, NaN for missing observations, and pre-computed rates.
    
    Parameters
    ----------
    all_params : dict
        Raw weather data: {'precip': {...}, 'temp': {...}, 'precip_type': {...}, ...}
    df_cml_dict : dict
        {cml_key: DataFrame with signal columns}
    df_cml_meta : DataFrame, optional
        CML metadata with 'cml_id', 'frequency', 'length' (for power-law R)
    interval : str, default '5min'
        Common resampling interval (e.g. '1min', '5min', '15min', '1H')
    signal_type : str, default 'attenuation'
        CML signal column to extract
    cml_to_pws_map : dict, optional
        Maps CML IDs → nearby PWS stations (to filter PWS)
    R_min : float, default 0.1
        Power-law minimum rain rate threshold (mm/h)
    
    Returns
    -------
    aligned_data : dict
        {
            'interval': str,
            'interval_hours': float,
            'precip': {source: DataFrame},
            'precip_rate': {source: DataFrame},
            'precip_rate_mean': {source: Series},
            'temp': {source: DataFrame},
            'precip_type': {source: DataFrame},
            'precip_type_reconciled': Series,   # NEW: unified type across all sources
            'cml_attenuation': DataFrame,
            'cml_R': DataFrame,
            'cml_R_mean': Series,
            'pl_params': dict,
            'n_obs': {source: DataFrame},
        }
    """
    interval_td = pd.Timedelta(interval)
    interval_hours = interval_td.total_seconds() / 3600.0
    
    precip_data = all_params.get('precip', {})
    temp_data   = all_params.get('temp', {})
    ptype_data  = all_params.get('precip_type', {})
    
    # --- Filter PWS stations if cml_to_pws_map provided ---
    pws_filter = None
    if cml_to_pws_map is not None:
        pws_filter = _get_pws_stations_for_cmls(df_cml_dict, cml_to_pws_map)
    
    result_precip      = {}
    result_precip_rate = {}
    result_precip_rate_mean = {}
    result_temp        = {}
    result_ptype       = {}
    result_nobs        = {}
    
    print("=" * 70)
    print(f"RESAMPLING ALL DATA TO '{interval}' GRID")
    print("=" * 70)
    
    # =================================================================
    # PRECIPITATION (accumulation → sum per bin, NaN for no-obs bins)
    # =================================================================
    for source_name, df_raw in precip_data.items():
        if df_raw is None or (hasattr(df_raw, 'empty') and df_raw.empty):
            continue
        if isinstance(df_raw, pd.Series):
            df_raw = df_raw.to_frame()
        
        # Filter PWS to matched stations
        if source_name == 'pws' and pws_filter is not None:
            avail = [s for s in pws_filter if s in df_raw.columns]
            if avail:
                df_raw = df_raw[avail]
        
        n_obs     = df_raw.resample(interval).count()
        resampled = df_raw.resample(interval).sum()
        resampled[n_obs == 0] = np.nan
        
        rate      = resampled / interval_hours
        rate_mean = rate.mean(axis=1)
        
        result_precip[source_name]           = resampled
        result_precip_rate[source_name]      = rate
        result_precip_rate_mean[source_name] = rate_mean
        result_nobs[source_name]             = n_obs
        
        n_stations = resampled.shape[1] if resampled.ndim > 1 else 1
        n_nonzero  = (resampled > 0).sum().sum()
        n_nan      = resampled.isna().sum().sum()
        print(f"  ✓ precip/{source_name}: {n_stations} station(s), "
              f"{len(resampled)} bins, {n_nonzero} non-zero, {n_nan} NaN (no-obs)")
    
    # =================================================================
    # TEMPERATURE (instantaneous → mean per bin)
    # =================================================================
    for source_name, df_raw in temp_data.items():
        if df_raw is None or (hasattr(df_raw, 'empty') and df_raw.empty):
            continue
        if isinstance(df_raw, pd.Series):
            df_raw = df_raw.to_frame()
        
        resampled = df_raw.resample(interval).mean()
        result_temp[source_name] = resampled
        print(f"  ✓ temp/{source_name}: {resampled.shape[1]} station(s), "
              f"{len(resampled)} bins")
    
    # =================================================================
    # PRECIP TYPE — with full reconciliation logic
    # =================================================================
    
    # -----------------------------------------------------------------
    # Helper: reconcile across stations at a single timestamp
    # -----------------------------------------------------------------
    def _reconcile_across_stations(row):
        """
        At one timestamp, combine all station values.
        rain + snow (from any station) → mix
        any rain → rain
        any snow → snow
        any precip → precip
        all dry → dry
        else → none
        """
        vals = row.dropna().tolist()
        vals = [str(v).strip().lower() for v in vals
                if str(v).strip().lower() not in ('nan', 'none', '')]
        if not vals:
            return 'none'
        has_rain = any(v in ('rain', 'mix') for v in vals)
        has_snow = any(v in ('snow', 'mix') for v in vals)
        if has_rain and has_snow:
            return 'mix'
        elif has_rain:
            return 'rain'
        elif has_snow:
            return 'snow'
        elif any(v == 'precip' for v in vals):
            return 'precip'
        elif all(v == 'dry' for v in vals):
            return 'dry'
        else:
            return 'none'
    
    # -----------------------------------------------------------------
    # Helper: resample a Series with active-wins logic
    # -----------------------------------------------------------------
    def _active_wins_resample(series):
        """
        Within a time bin: if ANY value is rain/snow/mix/precip → use it.
        Never let dry/none override an active type.
        rain + snow in same bin → mix
        """
        vals = series.dropna().tolist()
        vals = [str(v).strip().lower() for v in vals
                if str(v).strip().lower() not in ('nan', 'none', '')]
        if not vals:
            return 'none'
        has_rain = any(v in ('rain', 'mix') for v in vals)
        has_snow = any(v in ('snow', 'mix') for v in vals)
        if has_rain and has_snow:
            return 'mix'
        elif has_rain:
            return 'rain'
        elif has_snow:
            return 'snow'
        elif any(v == 'precip' for v in vals):
            return 'precip'
        elif any(v == 'dry' for v in vals):
            return 'dry'
        else:
            return 'none'
    
    # -----------------------------------------------------------------
    # Resample all precip sources first (needed for Step 4 upgrade)
    # -----------------------------------------------------------------
    all_precip_resampled = {}
    for p_source, p_df in precip_data.items():
        if p_df is None or (hasattr(p_df, 'empty') and p_df.empty):
            continue
        if isinstance(p_df, pd.Series):
            p_df = p_df.to_frame()
        p_resampled = p_df.resample(interval).sum()
        all_precip_resampled[p_source] = p_resampled
    
    # -----------------------------------------------------------------
    # Process each ptype source
    # -----------------------------------------------------------------
    result_ptype_reconciled = None  # unified across all sources
    
    for source_name, df_raw in ptype_data.items():
        if df_raw is None or (hasattr(df_raw, 'empty') and df_raw.empty):
            continue
        if isinstance(df_raw, pd.Series):
            df_raw = df_raw.to_frame()
        
        # ----------------------------------------------------------
        # Step 1: reconcile across stations per timestamp → Series
        # ----------------------------------------------------------
        reconciled_1min = df_raw.apply(_reconcile_across_stations, axis=1)
        
        # ----------------------------------------------------------
        # Step 2: resample bin with active-wins logic
        # ----------------------------------------------------------
        resampled_reconciled = reconciled_1min.resample(interval).apply(
            _active_wins_resample
        )
        
        # ----------------------------------------------------------
        # Step 3: per-station resample with active-wins
        # ----------------------------------------------------------
        per_station = df_raw.resample(interval).apply(
            lambda col: _active_wins_resample(col)
        )
        
        # Upgrade per-station: if reconciled is active but station is dry/none
        for col in per_station.columns:
            upgrade_mask = (
                resampled_reconciled.isin(['rain', 'snow', 'mix', 'precip']) &
                per_station[col].isin(['dry', 'none'])
            )
            per_station.loc[upgrade_mask, col] = resampled_reconciled[upgrade_mask]
        
        # ----------------------------------------------------------
        # Step 4: cross-check ALL numeric precip sources
        # if ANY source measured > 0 but type is dry/none → 'precip'
        # ----------------------------------------------------------
        if all_precip_resampled:
            # Build "any precip measured?" boolean mask on same index
            any_precip_mask = pd.Series(False, index=resampled_reconciled.index)
            
            for p_source, p_resampled in all_precip_resampled.items():
                source_any = (p_resampled.fillna(0) > 0).any(axis=1)
                source_any = source_any.reindex(
                    any_precip_mask.index, fill_value=False
                )
                any_precip_mask = any_precip_mask | source_any
            
            # Upgrade dry/none → 'precip' if precip was measured
            is_inactive      = resampled_reconciled.isin(['dry', 'none'])
            upgrade_to_precip = any_precip_mask & is_inactive
            
            if upgrade_to_precip.any():
                n_upgraded = upgrade_to_precip.sum()
                print(f"    ⚠ Upgraded {n_upgraded} bins: "
                      f"dry/none → 'precip' (numeric precip > 0)")
                resampled_reconciled[upgrade_to_precip] = 'precip'
                
                # Apply same upgrade to per-station columns
                for col in per_station.columns:
                    col_inactive = per_station[col].isin(['dry', 'none'])
                    per_station.loc[
                        upgrade_to_precip & col_inactive, col
                    ] = 'precip'
            
            # Summary per numeric source
            for p_source, p_resampled in all_precip_resampled.items():
                source_any = (
                    (p_resampled.fillna(0) > 0).any(axis=1)
                    .reindex(any_precip_mask.index, fill_value=False)
                )
                n = source_any.sum()
                if n > 0:
                    print(f"      → {p_source}: {n} bins with precip > 0")
        
        result_ptype[source_name]  = per_station
        result_ptype_reconciled    = resampled_reconciled  # last source wins
        # (typically only one source: asos_1min)
        
        print(f"  ✓ precip_type/{source_name}: {per_station.shape[1]} "
              f"station(s), {len(per_station)} bins")
        vc = per_station.apply(pd.Series.value_counts).fillna(0).astype(int)
        print(f"    Distribution:\n{vc.to_string()}")
    
    # =================================================================
    # CML ATTENUATION (instantaneous → mean per bin)
    # =================================================================
    cml_series = {}
    for cml_key, df in df_cml_dict.items():
        if df is None or df.empty:
            continue
        if signal_type not in df.columns:
            continue
        data = df[signal_type]
        if data.isna().all():
            continue
        cml_series[cml_key] = data.resample(interval).mean()
    
    df_cml_atten = pd.DataFrame(cml_series) if cml_series else pd.DataFrame()
    
    cml_nobs = pd.DataFrame()
    if cml_series:
        cml_nobs_dict = {}
        for cml_key, df in df_cml_dict.items():
            if df is None or df.empty or signal_type not in df.columns:
                continue
            cml_nobs_dict[cml_key] = df[signal_type].resample(interval).count()
        cml_nobs = pd.DataFrame(cml_nobs_dict)
        df_cml_atten[cml_nobs == 0] = np.nan
    
    result_nobs['cml'] = cml_nobs
    
    n_cml = df_cml_atten.shape[1]
    print(f"  ✓ cml/{signal_type}: {n_cml} links, {len(df_cml_atten)} bins")
    
    # =================================================================
    # CML POWER-LAW R
    # =================================================================
    pl_params  = {}
    df_cml_R   = pd.DataFrame(index=df_cml_atten.index)
    
    if df_cml_meta is not None and n_cml > 0:
        pl_params = _get_power_law_params_for_cmls(df_cml_dict, df_cml_meta)
        
        for cml_key, params in pl_params.items():
            if cml_key not in df_cml_atten.columns:
                continue
            atten_vals = df_cml_atten[cml_key].values
            R_vals = _calc_R_from_A(
                atten_vals, params['L_km'], params['a'], params['b'], R_min=R_min
            )
            df_cml_R[cml_key] = R_vals
        
        if len(pl_params) > 0:
            ex = list(pl_params.values())[0]
            print(f"  ✓ cml_R (power-law): {len(pl_params)} links "
                  f"(e.g. f={ex['f_GHz']:.1f}GHz, "
                  f"a={ex['a']:.4f}, b={ex['b']:.3f})")
    
    cml_R_mean = (df_cml_R.mean(axis=1) if len(df_cml_R.columns) > 0
                  else pd.Series(dtype=float))
    
    # =================================================================
    # BUILD RESULT
    # =================================================================
    aligned_data = {
        'interval':       interval,
        'interval_hours': interval_hours,
        
        'precip':              result_precip,
        'precip_rate':         result_precip_rate,
        'precip_rate_mean':    result_precip_rate_mean,
        
        'temp':                result_temp,
        'precip_type':         result_ptype,
        'precip_type_reconciled': result_ptype_reconciled,  # NEW
        
        'cml_attenuation':     df_cml_atten,
        'cml_R':               df_cml_R,
        'cml_R_mean':          cml_R_mean,
        
        'pl_params':           pl_params,
        'n_obs':               result_nobs,
    }
    
    print(f"\n{'='*70}")
    print(f"✓ aligned_data ready: interval='{interval}', "
          f"{len(result_precip)} precip sources, "
          f"{len(result_temp)} temp sources, "
          f"{n_cml} CML links")
    if result_ptype_reconciled is not None:
        vc = result_ptype_reconciled.value_counts()
        print(f"  precip_type reconciled: {vc.to_dict()}")
    print(f"{'='*70}\n")
    
    return aligned_data
    
