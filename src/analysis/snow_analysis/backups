# STANDALONE SCATTER PLOT
# ============================================================================

def plot_scatter_cml_precip(
    df_cml_dict=None,
    all_params=None,
    df_cml_meta=None,
    days=None,
    start_dt=None,
    end_dt=None,
    signal_type='attenuation',
    aggregate='15min',
    station='BKLN',
    cml_to_pws_map=None,
    figsize=None,
    color_by='cml',
    mode='per_cml',
    R_min=0.1,
    aligned_data=None,
):
    """
    Standalone scatter: CML power-law rain rate (y) vs ground-truth precip (x).
    
    Creates a 2-panel figure:
        Left  : CML R  vs  PWS mean precipitation
        Right : CML R  vs  ASOS/Official mean precipitation
    
    Parameters
    ----------
    df_cml_dict : dict, optional
        {cml_key: DataFrame with signal data}.  Not needed if aligned_data given.
    all_params : dict, optional
        Must contain 'precip' key.  Not needed if aligned_data given.
    df_cml_meta : DataFrame, optional
        CML metadata.  Not needed if aligned_data given.
    days : list or DatetimeIndex, optional
        Event days to scatter. Each day uses ±window around it.
    start_dt, end_dt : str or datetime, optional
        Custom time range (instead of days).
        If neither days/start_dt/end_dt given with aligned_data, uses full range.
    signal_type : str, default 'attenuation'
        Column name in CML DataFrames (raw path only)
    aggregate : str, default '15min'
        Resample interval for time alignment (raw path only; ignored if aligned_data)
    station : str, default 'BKLN'
        Mesonet station name for official data (raw path only)
    cml_to_pws_map : dict, optional
        Maps CML IDs to nearby PWS stations (raw path only)
    figsize : tuple, optional
        Figure size. Default (22, 9).
    color_by : str, default 'cml'
        'cml' = color per CML link, 'day' = color per event day.
        Ignored when mode='all'.
    mode : str, default 'per_cml'
        'per_cml' : one dot per CML per time step (separate links)
        'all'     : normalize by link length, average R across all CMLs per
                    time step -> one dot per time step.
    R_min : float, default 0.1
        Power-law minimum rain rate threshold (mm/h)
    aligned_data : dict, optional
        Output of resample_all().  When provided the function uses pre-resampled
        data and skips internal resampling.  Only days/start_dt/end_dt are used
        to slice the time axis; aggregate is taken from aligned_data['interval'].
    
    Examples
    --------
    # --- Using aligned_data (preferred) ---
    ad = resample_all(all_params, df_cml_filtered, df_cml_meta, interval='5min')
    plot_scatter_cml_precip(aligned_data=ad, days=rainy_days[:5], mode='all')
    
    # --- Raw path (backward compat) ---
    plot_scatter_cml_precip(
        df_cml_filtered, all_params, df_cml_meta,
        days=rainy_days[:5], aggregate='5min',
        cml_to_pws_map=cml_to_pws_map
    )
    """
    # ==================================================================
    # DECIDE PATH: aligned_data vs raw
    # ==================================================================
    use_aligned = aligned_data is not None
    
    if use_aligned:
        aggregate = aligned_data['interval']
        pl_params = aligned_data['pl_params']
        cml_R_full = aligned_data['cml_R']          # DataFrame (cols=cml_keys)
        cml_R_mean_full = aligned_data['cml_R_mean'] # Series
        precip_rate_mean = aligned_data.get('precip_rate_mean', {})
        precip_rate = aligned_data.get('precip_rate', {})
        
        if len(pl_params) == 0:
            print("⚠ aligned_data has no power-law params.")
            return
        ex = list(pl_params.values())[0]
        print(f"✓ Using aligned_data (interval='{aggregate}', "
              f"{len(pl_params)} CMLs, e.g. f={ex['f_GHz']:.1f} GHz)")
    else:
        # Legacy raw path: need all three
        if df_cml_dict is None or all_params is None or df_cml_meta is None:
            raise ValueError("Provide either aligned_data, or (df_cml_dict, all_params, df_cml_meta)")
        pl_params = _get_power_law_params_for_cmls(df_cml_dict, df_cml_meta)
        if len(pl_params) == 0:
            print("⚠ No power-law params could be extracted. Check df_cml_meta has 'frequency' and 'length'.")
            return
        ex = list(pl_params.values())[0]
        print(f"✓ Power-law for {len(pl_params)} CMLs (e.g. f={ex['f_GHz']:.1f} GHz, "
              f"a={ex['a']:.4f}, b={ex['b']:.3f}, L={ex['L_km']:.2f} km)")
    
    # ==================================================================
    # DETERMINE TIME WINDOWS
    # ==================================================================
    if start_dt is not None and end_dt is not None:
        windows = [(pd.to_datetime(start_dt), pd.to_datetime(end_dt))]
    elif days is not None:
        days = pd.to_datetime(days) if not isinstance(days, pd.DatetimeIndex) else days
        if isinstance(days, pd.Timestamp):
            days = [days]
        windows = [(d, d + pd.Timedelta(days=1)) for d in days]
    elif use_aligned:
        # Use full range from aligned_data
        idx = cml_R_full.index if len(cml_R_full) > 0 else pd.DatetimeIndex([])
        for src, s in precip_rate_mean.items():
            if len(s) > 0:
                idx = idx.union(s.index)
        if len(idx) > 0:
            windows = [(idx.min(), idx.max())]
        else:
            print("⚠ aligned_data is empty, nothing to plot.")
            return
    else:
        raise ValueError("Provide either 'days' or both 'start_dt' and 'end_dt'")
    
    # ==================================================================
    # SETUP PRECIP SOURCE AVAILABILITY
    # ==================================================================
    if use_aligned:
        has_pws = 'pws' in precip_rate_mean and len(precip_rate_mean['pws']) > 0
        has_official = any(
            k in precip_rate_mean and len(precip_rate_mean[k]) > 0
            for k in ('asos_1min', 'mesonet')
        )
    else:
        precip_data = all_params.get('precip', {})
        has_pws = 'pws' in precip_data
        has_official = 'asos_1min' in precip_data or 'mesonet' in precip_data
        pws_stations = _get_pws_stations_for_cmls(df_cml_dict, cml_to_pws_map)
        ri_minutes = pd.Timedelta(aggregate).total_seconds() / 60
        rate_factor = (60.0 / ri_minutes) if ri_minutes < 60 else 1.0
    
    sources = {}
    if has_pws:
        sources['PWS Mean'] = {'x': [], 'y': [], 'colors': [], 'cml_labels': []}
    if has_official:
        sources['Official (ASOS/Mesonet)'] = {'x': [], 'y': [], 'colors': [], 'cml_labels': []}
    
    if len(sources) == 0:
        print("⚠ No precipitation sources found")
        return
    
    cml_keys = list(pl_params.keys())
    cml_colors = plt.cm.tab10(np.linspace(0, 1, min(len(cml_keys), 10)))
    day_colors = plt.cm.Set1(np.linspace(0, 1, min(len(windows), 9)))
    
    # ==================================================================
    # LOOP OVER WINDOWS
    # ==================================================================
    for w_idx, (w_start, w_end) in enumerate(windows):
        
        if use_aligned:
            # ---------- ALIGNED DATA PATH ----------
            # PWS rate (already mm/h, already mean across stations)
            pws_rate = precip_rate_mean.get('pws')
            if pws_rate is not None:
                pws_rate = pws_rate.loc[w_start:w_end]
            
            # Official rate: combine available official sources
            official_rate = None
            off_parts = []
            for k in ('asos_1min', 'mesonet'):
                if k in precip_rate_mean:
                    s = precip_rate_mean[k].loc[w_start:w_end]
                    if len(s) > 0:
                        off_parts.append(s)
            if off_parts:
                official_rate = pd.concat(off_parts, axis=1).mean(axis=1)
            
            # CML R per link for this window
            cml_R_window = cml_R_full.loc[w_start:w_end]
            cml_R_series = {col: cml_R_window[col].dropna() for col in cml_R_window.columns
                           if not cml_R_window[col].isna().all()}
            
        else:
            # ---------- RAW DATA PATH (legacy) ----------
            pws_rate = None
            if 'PWS Mean' in sources and 'pws' in precip_data:
                df_pws = precip_data['pws'].loc[w_start:w_end]
                if pws_stations is not None:
                    avail = [s for s in pws_stations if s in df_pws.columns]
                    if avail:
                        df_pws = df_pws[avail]
                if len(df_pws) > 0:
                    pws_rate = df_pws.resample(aggregate).sum().mean(axis=1) * rate_factor
            
            official_rate = None
            if 'Official (ASOS/Mesonet)' in sources:
                official_parts = []
                if 'asos_1min' in precip_data:
                    asos = precip_data['asos_1min'].loc[w_start:w_end]
                    if len(asos) > 0:
                        official_parts.append(asos.resample(aggregate).sum().mean(axis=1))
                if 'mesonet' in precip_data:
                    meso = precip_data['mesonet'].loc[w_start:w_end]
                    if station in meso.columns:
                        official_parts.append(meso[station].resample(aggregate).sum())
                if official_parts:
                    official_rate = pd.concat(official_parts, axis=1).mean(axis=1) * rate_factor
            
            cml_R_series = {}
            for cml_key, params in pl_params.items():
                df = df_cml_dict.get(cml_key)
                if df is None or df.empty or signal_type not in df.columns:
                    continue
                atten = df.loc[w_start:w_end, signal_type]
                if atten.empty or atten.isna().all():
                    continue
                atten = atten.resample(aggregate).mean()
                R_est = _calc_R_from_A(atten.values, params['L_km'], params['a'], params['b'], R_min=R_min)
                cml_R_series[cml_key] = pd.Series(R_est, index=atten.index)
        
        if len(cml_R_series) == 0:
            continue
        
        if mode == 'all':
            # ---- MODE 'all': average R across CMLs per time step ----
            df_R_all = pd.DataFrame(cml_R_series)
            R_mean = df_R_all.mean(axis=1)
            
            color = day_colors[w_idx % 9] if len(windows) > 1 else 'steelblue'
            
            # Match to PWS
            if pws_rate is not None and 'PWS Mean' in sources:
                common = R_mean.index.intersection(pws_rate.index)
                if len(common) > 0:
                    px = pws_rate.loc[common].values
                    ry = R_mean.loc[common].values
                    mask = (px > 0) | (ry > 0)
                    if mask.sum() > 0:
                        sources['PWS Mean']['x'].extend(px[mask])
                        sources['PWS Mean']['y'].extend(ry[mask])
                        sources['PWS Mean']['colors'].extend([color] * mask.sum())
                        sources['PWS Mean']['cml_labels'].extend(['mean'] * mask.sum())
            
            # Match to Official
            if official_rate is not None and 'Official (ASOS/Mesonet)' in sources:
                common = R_mean.index.intersection(official_rate.index)
                if len(common) > 0:
                    ox = official_rate.loc[common].values
                    ry = R_mean.loc[common].values
                    mask = (ox > 0) | (ry > 0)
                    if mask.sum() > 0:
                        sources['Official (ASOS/Mesonet)']['x'].extend(ox[mask])
                        sources['Official (ASOS/Mesonet)']['y'].extend(ry[mask])
                        sources['Official (ASOS/Mesonet)']['colors'].extend([color] * mask.sum())
                        sources['Official (ASOS/Mesonet)']['cml_labels'].extend(['mean'] * mask.sum())
        
        else:
            # ---- MODE 'per_cml': one dot per CML per time step ----
            for c_idx, (cml_key, R_series) in enumerate(cml_R_series.items()):
                color = cml_colors[c_idx % 10] if color_by == 'cml' else day_colors[w_idx % 9]
                R_vals = R_series.values
                
                # Match to PWS
                if pws_rate is not None and 'PWS Mean' in sources:
                    common = R_series.index.intersection(pws_rate.index)
                    if len(common) > 0:
                        px = pws_rate.loc[common].values
                        ry = R_vals[np.isin(R_series.index, common)]
                        mask = (px > 0) | (ry > 0)
                        if mask.sum() > 0:
                            sources['PWS Mean']['x'].extend(px[mask])
                            sources['PWS Mean']['y'].extend(ry[mask])
                            sources['PWS Mean']['colors'].extend([color] * mask.sum())
                            sources['PWS Mean']['cml_labels'].extend([cml_key] * mask.sum())
                
                # Match to Official
                if official_rate is not None and 'Official (ASOS/Mesonet)' in sources:
                    common = R_series.index.intersection(official_rate.index)
                    if len(common) > 0:
                        ox = official_rate.loc[common].values
                        ry = R_vals[np.isin(R_series.index, common)]
                        mask = (ox > 0) | (ry > 0)
                        if mask.sum() > 0:
                            sources['Official (ASOS/Mesonet)']['x'].extend(ox[mask])
                            sources['Official (ASOS/Mesonet)']['y'].extend(ry[mask])
                            sources['Official (ASOS/Mesonet)']['colors'].extend([color] * mask.sum())
                            sources['Official (ASOS/Mesonet)']['cml_labels'].extend([cml_key] * mask.sum())
    
    # --- Remove empty sources ---
    sources = {k: v for k, v in sources.items() if len(v['x']) > 0}
    if len(sources) == 0:
        print("⚠ No overlapping non-zero data found for any source.")
        return
    
    # --- Plot ---
    n_panels = len(sources)
    if figsize is None:
        figsize = (12 * n_panels, 10)
    
    fig, axes = plt.subplots(1, n_panels, figsize=figsize)
    if n_panels == 1:
        axes = [axes]
    
    for ax, (src_name, data) in zip(axes, sources.items()):
        x = np.array(data['x'])
        y = np.array(data['y'])
        colors = data['colors']
        
        ax.scatter(x, y, c=colors, s=35, alpha=0.55, edgecolors='k', linewidths=0.3, zorder=3)
        
        # 1:1 line
        max_val = max(np.nanmax(x), np.nanmax(y)) if len(x) > 0 else 10
        ax.plot([0, max_val * 1.2], [0, max_val * 1.2], 'k--', lw=1.5, alpha=0.5, 
                label='1:1 line', zorder=1)
        
        # Stats
        valid = np.isfinite(x) & np.isfinite(y) & (x > 0) & (y > 0)
        if valid.sum() > 2:
            corr = np.corrcoef(x[valid], y[valid])[0, 1]
            bias = np.mean(y[valid] - x[valid])
            rmse = np.sqrt(np.mean((y[valid] - x[valid])**2))
            mae = np.mean(np.abs(y[valid] - x[valid]))
            stats_text = (f'n = {valid.sum()}\n'
                         f'r = {corr:.3f}\n'
                         f'bias = {bias:.3f} mm/h\n'
                         f'RMSE = {rmse:.3f} mm/h\n'
                         f'MAE = {mae:.3f} mm/h')
            ax.text(0.03, 0.97, stats_text, transform=ax.transAxes, fontsize=13,
                    va='top', ha='left', family='monospace',
                    bbox=dict(boxstyle='round', facecolor='lightyellow', alpha=0.9))
        
        # Robust axis limits (98th percentile)
        if valid.sum() > 0:
            q98 = max(np.quantile(x[valid], 0.98), np.quantile(y[valid], 0.98))
            lim = q98 * 1.3
            ax.set_xlim(0, lim)
            ax.set_ylim(0, lim)
        
        ax.set_xlabel(f'{src_name} Precip (mm/h)', fontweight='bold', fontsize=15)
        if mode == 'all':
            ax.set_ylabel('CML Mean R (mm/h)\n[avg across links, normalized by L]', fontweight='bold', fontsize=14)
        else:
            ax.set_ylabel('CML Power-Law R (mm/h)', fontweight='bold', fontsize=15)
        ax.set_title(f'CML vs {src_name}', fontweight='bold', fontsize=17)
        ax.set_aspect('equal', adjustable='box')
        ax.grid(True, alpha=0.25, linewidth=0.5)
        ax.legend(loc='lower right', fontsize=12)
        ax.tick_params(axis='both', labelsize=13)
    
    # Build legend for color mapping
    if mode == 'per_cml' and color_by == 'cml':
        legend_handles = []
        seen = set()
        for c_idx, cml_key in enumerate(cml_keys):
            if cml_key in pl_params and cml_key not in seen and c_idx < 10:
                p = pl_params[cml_key]
                legend_handles.append(
                    Line2D([0], [0], marker='o', color='w', markerfacecolor=cml_colors[c_idx % 10],
                           markersize=8, label=f'f={p["f_GHz"]:.0f}GHz L={p["L_km"]:.1f}km'))
                seen.add(cml_key)
        if legend_handles:
            fig.legend(handles=legend_handles, loc='upper center', ncol=min(len(legend_handles), 5),
                      fontsize=11, framealpha=0.9, bbox_to_anchor=(0.5, 0.02))
    elif mode == 'all' and len(windows) > 1:
        # Color legend by day when mode='all' with multiple days
        legend_handles = []
        for w_idx, (w_start, w_end) in enumerate(windows[:9]):
            legend_handles.append(
                Line2D([0], [0], marker='o', color='w', markerfacecolor=day_colors[w_idx % 9],
                       markersize=8, label=w_start.strftime('%Y-%m-%d')))
        if legend_handles:
            fig.legend(handles=legend_handles, loc='upper center', ncol=min(len(legend_handles), 5),
                      fontsize=11, framealpha=0.9, bbox_to_anchor=(0.5, 0.02))
    
    # Title
    if start_dt is not None and end_dt is not None:
        period_str = f'{pd.to_datetime(start_dt).strftime("%Y-%m-%d")} → {pd.to_datetime(end_dt).strftime("%Y-%m-%d")}'
    else:
        period_str = f'{len(windows)} event days'
    
    mode_str = 'mean across CMLs' if mode == 'all' else f'{len(pl_params)} CMLs'
    fig.suptitle(f'CML Power-Law Scatter ({mode_str}, {period_str}, agg={aggregate})',
                fontsize=19, fontweight='bold')
    plt.tight_layout(rect=[0, 0.05, 1, 0.95])
    plt.show()
    
    total_pts = sum(len(v['x']) for v in sources.values())
    if mode == 'all':
        print(f"✓ Scatter (mode='all'): {total_pts} time steps, "
              f"R averaged across {len(pl_params)} CMLs (each normalized by its own L)")
    else:
        print(f"✓ Scatter: {total_pts} points across {n_panels} source(s)")


# ============================================================================
# UNIFIED SCATTER: plot_scatter()
# ============================================================================

def plot_scatter(
    aligned_data,
    scatter_type='all',
    days=None,
    start_dt=None,
    end_dt=None,
    mode='all',
    color_by='temp',
    temp_threshold=0.0,
    temp_source=None,
    figsize=None,
    point_size=90,
    label_size=18,
    title_size=22,
    tick_size=15,
    legend_size=14,
    stats_size=14,
    color_cold='royalblue',
    color_warm='coral',
    style='scatter',
    gridsize=30,
    cmap_density='YlOrRd',
    cmap_temp='coolwarm',
):
    """
    Unified scatter plot for CML and weather-station comparisons.
    
    Wraps all scatter approaches in one function: CML-vs-ground-truth and
    ground-truth-vs-ground-truth, with flexible coloring, heatmap support,
    and large, publication-ready defaults.
    
    Parameters
    ----------
    aligned_data : dict
        Output of resample_all().
    scatter_type : str
        Which panel(s) to show:
        - 'cml_vs_pws'       : CML R vs PWS precipitation  (1 panel)
        - 'cml_vs_official'   : CML R vs ASOS/Mesonet       (1 panel)
        - 'cml_vs_all'        : both CML panels             (2 panels)
        - 'pws_vs_official'   : PWS vs ASOS/Mesonet         (1 panel)
        - 'all'               : all 3 panels                 (3 panels)
    days : list or DatetimeIndex, optional
        Event days.  Each day -> one 24 h window.
    start_dt, end_dt : str or datetime, optional
        Custom time range (instead of days).
        If nothing given, uses the full aligned_data range.
    mode : str, default 'all'
        CML aggregation (only affects CML panels):
        - 'all'     : average R across CMLs per time step (one dot)
        - 'per_cml' : one dot per CML per time step
    color_by : str, default 'temp'
        - 'temp' : color by temperature relative to temp_threshold.
                   For hexbin: hex color = mean T per bin.
        - 'cml'  : color per CML link (only mode='per_cml', scatter only)
        - 'day'  : color per event day (scatter only)
    temp_threshold : float, default 0.0
        Celsius threshold for color_by='temp'.
    temp_source : str, optional
        Key in aligned_data['temp'] to use.  If None, first available.
    figsize : tuple, optional
        Figure size.  Default scales with number of panels.
    point_size : int, default 90
        Scatter marker size (for style='scatter'/'density').
    label_size, title_size, tick_size, legend_size, stats_size : int
        Font sizes for various elements.
    color_cold, color_warm : str
        Colors for temp coloring in scatter mode.
    style : str, default 'scatter'
        - 'scatter' : individual colored dots (default)
        - 'hexbin'  : hexagonal density heatmap (best for many points).
                      If color_by='temp', hex color = mean T per bin.
                      Otherwise hex color = density count.
        - 'density' : scatter colored by local point density (KDE).
    gridsize : int, default 30
        Hex grid resolution for style='hexbin'.
    cmap_density : str, default 'YlOrRd'
        Colormap for density (hexbin count or KDE density).
    cmap_temp : str, default 'coolwarm'
        Colormap for hexbin with color_by='temp'.
    
    Returns
    -------
    fig : matplotlib Figure
    
    Examples
    --------
    ad = resample_all(all_params, df_cml_filtered, df_cml_meta, interval='5min')
    
    # All 3 panels, colored by temperature
    plot_scatter(ad, scatter_type='all', days=rainy_days[:5])
    
    # Hexbin heatmap (best for many points)
    plot_scatter(ad, days=rainy_days, style='hexbin')
    
    # Hexbin with mean temperature per bin
    plot_scatter(ad, days=rainy_days, style='hexbin', color_by='temp', temp_threshold=2.0)
    
    # Density-colored scatter (KDE)
    plot_scatter(ad, days=rainy_days, style='density')
    
    # Per-CML coloring
    plot_scatter(ad, scatter_type='cml_vs_pws', mode='per_cml', color_by='cml')
    """
    # ------------------------------------------------------------------
    # Unpack aligned_data
    # ------------------------------------------------------------------
    precip_rate_mean = aligned_data.get('precip_rate_mean', {})
    cml_R = aligned_data.get('cml_R', pd.DataFrame())
    cml_R_mean = aligned_data.get('cml_R_mean', pd.Series(dtype=float))
    pl_params = aligned_data.get('pl_params', {})
    interval = aligned_data.get('interval', '5min')
    
    # ------------------------------------------------------------------
    # Panel definitions
    # ------------------------------------------------------------------
    ALL_PANELS = [
        {
            'key': 'cml_vs_pws',
            'x_key': 'pws',
            'y_key': 'cml',
            'xlabel': 'PWS Precip Rate (mm/h)',
            'ylabel_all': 'CML Mean R (mm/h)',
            'ylabel_per': 'CML R per link (mm/h)',
            'title': 'CML vs PWS',
        },
        {
            'key': 'cml_vs_official',
            'x_key': 'official',
            'y_key': 'cml',
            'xlabel': 'Official Precip Rate (mm/h)',
            'ylabel_all': 'CML Mean R (mm/h)',
            'ylabel_per': 'CML R per link (mm/h)',
            'title': 'CML vs Official (ASOS / Mesonet)',
        },
        {
            'key': 'pws_vs_official',
            'x_key': 'official',
            'y_key': 'pws',
            'xlabel': 'Official Precip Rate (mm/h)',
            'ylabel_all': 'PWS Mean Precip Rate (mm/h)',
            'ylabel_per': 'PWS Mean Precip Rate (mm/h)',
            'title': 'PWS vs Official (ASOS / Mesonet)',
        },
    ]
    
    TYPE_MAP = {
        'cml_vs_pws':      ['cml_vs_pws'],
        'cml_vs_official':  ['cml_vs_official'],
        'cml_vs_all':       ['cml_vs_pws', 'cml_vs_official'],
        'pws_vs_official':  ['pws_vs_official'],
        'all':              ['cml_vs_pws', 'cml_vs_official', 'pws_vs_official'],
    }
    
    selected_keys = TYPE_MAP.get(scatter_type, TYPE_MAP['all'])
    panels = [p for p in ALL_PANELS if p['key'] in selected_keys]
    
    if len(panels) == 0:
        print(f"⚠ Unknown scatter_type='{scatter_type}'. "
              f"Choose from: {list(TYPE_MAP.keys())}")
        return
    
    # ------------------------------------------------------------------
    # Time windows
    # ------------------------------------------------------------------
    if start_dt is not None and end_dt is not None:
        windows = [(pd.to_datetime(start_dt), pd.to_datetime(end_dt))]
    elif days is not None:
        _days = pd.to_datetime(days) if not isinstance(days, pd.DatetimeIndex) else days
        if isinstance(_days, pd.Timestamp):
            _days = [_days]
        windows = [(d, d + pd.Timedelta(days=1)) for d in _days]
    else:
        # Full range from aligned_data
        all_idx = pd.DatetimeIndex([])
        if len(cml_R_mean) > 0:
            all_idx = all_idx.union(cml_R_mean.index)
        for s in precip_rate_mean.values():
            if s is not None and len(s) > 0:
                all_idx = all_idx.union(s.index)
        if len(all_idx) > 0:
            windows = [(all_idx.min(), all_idx.max())]
        else:
            print("⚠ No data in aligned_data.")
            return
    
    # ------------------------------------------------------------------
    # Temperature series (for color_by='temp')
    # ------------------------------------------------------------------
    temp_series = None
    if color_by == 'temp':
        temp_dict = aligned_data.get('temp', {})
        if temp_source and temp_source in temp_dict:
            df_t = temp_dict[temp_source]
            temp_series = df_t.mean(axis=1) if df_t.ndim > 1 else df_t
            print(f"✓ Temp coloring: source='{temp_source}', threshold={temp_threshold}°C")
        else:
            for src_name, df_t in temp_dict.items():
                if df_t is not None and not (hasattr(df_t, 'empty') and df_t.empty):
                    temp_series = df_t.mean(axis=1) if df_t.ndim > 1 else df_t
                    print(f"✓ Temp coloring: source='{src_name}', threshold={temp_threshold}°C")
                    break
        if temp_series is None:
            print("⚠ No temperature data found — falling back to single color.")
            color_by = 'none'
    
    # ------------------------------------------------------------------
    # Helpers to retrieve series for a panel axis
    # ------------------------------------------------------------------
    def _get_official_rate(w_start, w_end):
        """Combine ASOS + Mesonet into a single official rate Series."""
        parts = []
        for k in ('asos_1min', 'mesonet'):
            s = precip_rate_mean.get(k)
            if s is not None and len(s) > 0:
                sliced = s.loc[w_start:w_end]
                if len(sliced) > 0:
                    parts.append(sliced)
        if parts:
            return pd.concat(parts, axis=1).mean(axis=1)
        return None
    
    def _get_series(key, w_start, w_end):
        """
        Return the appropriate Series (or DataFrame for per-cml CML).
        key: 'pws', 'official', 'cml'
        """
        if key == 'pws':
            s = precip_rate_mean.get('pws')
            if s is not None and len(s) > 0:
                return s.loc[w_start:w_end]
            return None
        elif key == 'official':
            return _get_official_rate(w_start, w_end)
        elif key == 'cml':
            if mode == 'per_cml':
                if len(cml_R.columns) > 0:
                    return cml_R.loc[w_start:w_end]  # DataFrame
                return None
            else:
                if len(cml_R_mean) > 0:
                    return cml_R_mean.loc[w_start:w_end]  # Series
                return None
        return None
    
    # ------------------------------------------------------------------
    # Collect scatter data for each panel
    # ------------------------------------------------------------------
    cml_keys = list(pl_params.keys()) if pl_params else list(cml_R.columns)
    cml_cmap = plt.cm.tab10(np.linspace(0, 1, min(max(len(cml_keys), 1), 10)))
    day_cmap = plt.cm.Set1(np.linspace(0, 1, min(max(len(windows), 1), 9)))
    
    panel_data = {
        p['key']: {'x': [], 'y': [], 'ts': [], 'cml_labels': [], 'w_idx': []}
        for p in panels
    }
    
    for w_idx, (w_start, w_end) in enumerate(windows):
        for panel in panels:
            pk = panel['key']
            x_data = _get_series(panel['x_key'], w_start, w_end)
            y_data = _get_series(panel['y_key'], w_start, w_end)
            
            if x_data is None or y_data is None:
                continue
            
            # Determine if we need per-CML expansion (DataFrame on one side)
            is_per_cml = (isinstance(y_data, pd.DataFrame) and panel['y_key'] == 'cml'
                          and mode == 'per_cml')
            
            if is_per_cml:
                # x_data is a Series (PWS or Official), y_data is DataFrame (CML per link)
                x_ref = x_data.dropna() if isinstance(x_data, pd.Series) else x_data
                for cml_key in y_data.columns:
                    y_col = y_data[cml_key].dropna()
                    if y_col.empty:
                        continue
                    common = y_col.index.intersection(x_ref.index)
                    if len(common) == 0:
                        continue
                    xv = x_ref.loc[common].values
                    yv = y_col.loc[common].values
                    mask = np.isfinite(xv) & np.isfinite(yv) & ((xv > 0) | (yv > 0))
                    n = mask.sum()
                    if n == 0:
                        continue
                    panel_data[pk]['x'].extend(xv[mask])
                    panel_data[pk]['y'].extend(yv[mask])
                    panel_data[pk]['ts'].extend(common[mask].tolist())
                    panel_data[pk]['cml_labels'].extend([cml_key] * n)
                    panel_data[pk]['w_idx'].extend([w_idx] * n)
            else:
                # Both are Series
                x_s = x_data if isinstance(x_data, pd.Series) else x_data.mean(axis=1)
                y_s = y_data if isinstance(y_data, pd.Series) else y_data.mean(axis=1)
                common = x_s.dropna().index.intersection(y_s.dropna().index)
                if len(common) == 0:
                    continue
                xv = x_s.loc[common].values
                yv = y_s.loc[common].values
                mask = np.isfinite(xv) & np.isfinite(yv) & ((xv > 0) | (yv > 0))
                n = mask.sum()
                if n == 0:
                    continue
                panel_data[pk]['x'].extend(xv[mask])
                panel_data[pk]['y'].extend(yv[mask])
                panel_data[pk]['ts'].extend(common[mask].tolist())
                panel_data[pk]['cml_labels'].extend(['mean'] * n)
                panel_data[pk]['w_idx'].extend([w_idx] * n)
    
    # Remove empty panels
    active_panels = [p for p in panels if len(panel_data[p['key']]['x']) > 0]
    if len(active_panels) == 0:
        print("⚠ No overlapping non-zero data found for any panel.")
        return
    
    # ------------------------------------------------------------------
    # Assign colors
    # ------------------------------------------------------------------
    def _assign_colors(data):
        n = len(data['x'])
        if color_by == 'temp' and temp_series is not None:
            ts_idx = pd.DatetimeIndex(data['ts'])
            temp_vals = temp_series.reindex(ts_idx, method='nearest').values
            colors = []
            for tv in temp_vals:
                if not np.isfinite(tv):
                    colors.append('silver')
                elif tv < temp_threshold:
                    colors.append(color_cold)
                else:
                    colors.append(color_warm)
            return colors
        elif color_by == 'cml' and mode == 'per_cml':
            key_to_idx = {k: i for i, k in enumerate(cml_keys)}
            return [cml_cmap[key_to_idx.get(lbl, 0) % 10] for lbl in data['cml_labels']]
        elif color_by == 'day':
            return [day_cmap[w % 9] for w in data['w_idx']]
        else:
            return ['steelblue'] * n
    
    # ------------------------------------------------------------------
    # Plot
    # ------------------------------------------------------------------
    n_panels = len(active_panels)
    if figsize is None:
        figsize = (14 * n_panels, 12)
    
    fig, axes = plt.subplots(1, n_panels, figsize=figsize)
    if n_panels == 1:
        axes = [axes]
    
    for ax, panel in zip(axes, active_panels):
        data = panel_data[panel['key']]
        x = np.array(data['x'])
        y = np.array(data['y'])
        
        # --- Axis limits (computed first, used by all styles) ---
        valid = np.isfinite(x) & np.isfinite(y) & (x > 0) & (y > 0)
        if valid.sum() > 0:
            q98 = max(np.quantile(x[valid], 0.98), np.quantile(y[valid], 0.98))
            lim = max(q98 * 1.3, 0.5)
        else:
            lim = max(np.nanmax(x), np.nanmax(y)) * 1.2 if len(x) > 0 else 10
        
        # ============================================================
        # STYLE: hexbin
        # ============================================================
        if style == 'hexbin':
            from matplotlib.colors import TwoSlopeNorm, LogNorm
            
            if color_by == 'temp' and temp_series is not None:
                # Hex color = mean temperature per bin
                ts_idx = pd.DatetimeIndex(data['ts'])
                temp_vals = temp_series.reindex(ts_idx, method='nearest').values
                
                # Center colormap on temp_threshold
                t_valid = temp_vals[np.isfinite(temp_vals)]
                if len(t_valid) > 0:
                    t_min = min(t_valid.min(), temp_threshold - 5)
                    t_max = max(t_valid.max(), temp_threshold + 5)
                    norm = TwoSlopeNorm(vmin=t_min, vcenter=temp_threshold, vmax=t_max)
                else:
                    norm = None
                
                hb = ax.hexbin(x, y, C=temp_vals, reduce_C_function=np.nanmean,
                               gridsize=gridsize, cmap=cmap_temp, mincnt=1,
                               extent=[0, lim, 0, lim], norm=norm, zorder=2)
                cb = fig.colorbar(hb, ax=ax, shrink=0.8, pad=0.02)
                cb.set_label(f'Mean Temperature (°C)', fontsize=label_size - 2)
                cb.ax.tick_params(labelsize=tick_size - 2)
                # Add threshold line on colorbar
                cb.ax.axhline(y=temp_threshold, color='k', linewidth=1.5, linestyle='--')
            else:
                # Hex color = point count (density)
                hb = ax.hexbin(x, y, gridsize=gridsize, cmap=cmap_density, mincnt=1,
                               extent=[0, lim, 0, lim], zorder=2)
                cb = fig.colorbar(hb, ax=ax, shrink=0.8, pad=0.02)
                cb.set_label('Count per bin', fontsize=label_size - 2)
                cb.ax.tick_params(labelsize=tick_size - 2)
        
        # ============================================================
        # STYLE: density (KDE-colored scatter)
        # ============================================================
        elif style == 'density':
            from scipy.stats import gaussian_kde
            
            # Compute KDE on valid points
            if valid.sum() > 10:
                xy_valid = np.vstack([x[valid], y[valid]])
                try:
                    kde = gaussian_kde(xy_valid)
                    density_vals = kde(xy_valid)
                except Exception:
                    density_vals = np.ones(valid.sum())
                
                # Sort so densest points are drawn on top
                order = density_vals.argsort()
                ax.scatter(x[valid][order], y[valid][order], c=density_vals[order],
                           s=point_size, cmap=cmap_density, alpha=0.75,
                           edgecolors='none', zorder=3)
                
                # Colorbar for density
                sm = plt.cm.ScalarMappable(cmap=cmap_density,
                                           norm=plt.Normalize(density_vals.min(), density_vals.max()))
                sm.set_array([])
                cb = fig.colorbar(sm, ax=ax, shrink=0.8, pad=0.02)
                cb.set_label('Point density', fontsize=label_size - 2)
                cb.ax.tick_params(labelsize=tick_size - 2)
            else:
                ax.scatter(x, y, c='steelblue', s=point_size, alpha=0.6,
                           edgecolors='k', linewidths=0.4, zorder=3)
        
        # ============================================================
        # STYLE: scatter (default — individual colored dots)
        # ============================================================
        else:
            colors = _assign_colors(data)
            ax.scatter(x, y, c=colors, s=point_size, alpha=0.6,
                       edgecolors='k', linewidths=0.4, zorder=3)
        
        # --- 1:1 line (all styles) ---
        ax.plot([0, lim], [0, lim], 'k--', lw=2, alpha=0.5, label='1:1', zorder=4)
        
        # --- Statistics box (all styles) ---
        if valid.sum() > 2:
            corr = np.corrcoef(x[valid], y[valid])[0, 1]
            bias = np.mean(y[valid] - x[valid])
            rmse = np.sqrt(np.mean((y[valid] - x[valid])**2))
            mae = np.mean(np.abs(y[valid] - x[valid]))
            stats_text = (f'n = {valid.sum()}\n'
                         f'r = {corr:.3f}\n'
                         f'bias = {bias:.2f} mm/h\n'
                         f'RMSE = {rmse:.2f} mm/h\n'
                         f'MAE = {mae:.2f} mm/h')
            ax.text(0.03, 0.97, stats_text, transform=ax.transAxes, fontsize=stats_size,
                    va='top', ha='left', family='monospace',
                    bbox=dict(boxstyle='round', facecolor='lightyellow', alpha=0.9))
        
        # --- Axis limits, labels, formatting (all styles) ---
        ax.set_xlim(0, lim)
        ax.set_ylim(0, lim)
        
        ylabel = panel['ylabel_all'] if mode == 'all' or panel['y_key'] != 'cml' else panel['ylabel_per']
        ax.set_xlabel(panel['xlabel'], fontweight='bold', fontsize=label_size)
        ax.set_ylabel(ylabel, fontweight='bold', fontsize=label_size)
        ax.set_title(panel['title'], fontweight='bold', fontsize=title_size)
        ax.set_aspect('equal', adjustable='box')
        ax.grid(True, alpha=0.25, linewidth=0.5)
        ax.tick_params(axis='both', labelsize=tick_size)
        ax.legend(loc='lower right', fontsize=legend_size)
    
    # ------------------------------------------------------------------
    # Color legend (below figure — only for scatter style)
    # ------------------------------------------------------------------
    legend_handles = []
    if style == 'scatter' and color_by == 'temp':
        legend_handles.append(
            Patch(facecolor=color_cold, edgecolor='k', label=f'T < {temp_threshold}°C'))
        legend_handles.append(
            Patch(facecolor=color_warm, edgecolor='k', label=f'T ≥ {temp_threshold}°C'))
        legend_handles.append(
            Patch(facecolor='silver', edgecolor='k', label='T unknown'))
    elif style == 'scatter' and color_by == 'cml' and mode == 'per_cml':
        for c_idx, cml_key in enumerate(cml_keys[:10]):
            p = pl_params.get(cml_key, {})
            lbl = (f"f={p['f_GHz']:.0f}GHz L={p['L_km']:.1f}km"
                   if 'f_GHz' in p else str(cml_key))
            legend_handles.append(
                Line2D([0], [0], marker='o', color='w',
                       markerfacecolor=cml_cmap[c_idx % 10],
                       markersize=10, label=lbl))
    elif style == 'scatter' and color_by == 'day' and len(windows) > 1:
        for w_idx, (ws, we) in enumerate(windows[:9]):
            legend_handles.append(
                Line2D([0], [0], marker='o', color='w',
                       markerfacecolor=day_cmap[w_idx % 9],
                       markersize=10, label=ws.strftime('%Y-%m-%d')))
    
    if legend_handles:
        fig.legend(handles=legend_handles, loc='upper center',
                   ncol=min(len(legend_handles), 6), fontsize=legend_size,
                   framealpha=0.9, bbox_to_anchor=(0.5, 0.02))
    
    # ------------------------------------------------------------------
    # Suptitle
    # ------------------------------------------------------------------
    mode_str = 'mean across CMLs' if mode == 'all' else f'{len(cml_keys)} CMLs'
    if start_dt is not None and end_dt is not None:
        period = (f'{pd.to_datetime(start_dt).strftime("%Y-%m-%d")} → '
                  f'{pd.to_datetime(end_dt).strftime("%Y-%m-%d")}')
    elif days is not None:
        period = f'{len(windows)} event day(s)'
    else:
        period = 'full range'
    
    color_str = (f'T threshold={temp_threshold}°C' if color_by == 'temp'
                 else f'color={color_by}')
    style_str = style if style != 'scatter' else ''
    parts = [mode_str, period, interval, color_str]
    if style_str:
        parts.append(style_str)
    fig.suptitle(
        f'Scatter Comparison  —  {" | ".join(parts)}',
        fontsize=title_size + 2, fontweight='bold')
    plt.tight_layout(rect=[0, 0.06, 1, 0.93])
    plt.show()
    
    total = sum(len(panel_data[p['key']]['x']) for p in active_panels)
    print(f"✓ Scatter: {total} total points across {len(active_panels)} panel(s)")
    if color_by == 'temp' and temp_series is not None:
        all_ts = []
        for p in active_panels:
            all_ts.extend(panel_data[p['key']]['ts'])
        if all_ts:
            ts_idx = pd.DatetimeIndex(all_ts)
            tv = temp_series.reindex(ts_idx, method='nearest')
            n_cold = (tv < temp_threshold).sum()
            n_warm = (tv >= temp_threshold).sum()
            print(f"  T < {temp_threshold}°C: {n_cold} points  |  "
                  f"T ≥ {temp_threshold}°C: {n_warm} points")
    
    return fig


