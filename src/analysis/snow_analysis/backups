def _plot_cml_signal(ax, df_cml_dict, window_start, window_end, event_day=None, 
                     signal_type='attenuation', event_color='red', df_cml_meta=None, 
                     emphasize_cml_ids=None, resample_interval=None,
                     linewidth=2.5, linewidth_emphasized=4.0):
    """Plot CML signal (RSL or attenuation)."""
    colors = plt.cm.tab10(np.linspace(0, 1, min(len(df_cml_dict), 10)))
    
    emphasize_set = set()
    if emphasize_cml_ids is not None:
        emphasize_set = {str(cid) for cid in emphasize_cml_ids}
    
    plotted_count = 0
    for i, (cml_key, df) in enumerate(df_cml_dict.items()):
        # Skip empty dataframes
        if df is None or df.empty:
            continue
        
        if signal_type not in df.columns:
            continue
        
        data = df.loc[window_start:window_end, signal_type]
        
        # Skip if no data in window
        if data.empty or data.isna().all():
            continue
        
        # Apply resampling if specified
        if resample_interval is not None and len(data) > 0:
            data = data.resample(resample_interval).mean()
        
        if len(data) > 0:
            cml_id_str = str(cml_key.split('_')[0])
            is_emphasized = cml_id_str in emphasize_set
            
            # Build label from metadata
            label = cml_key
            if df_cml_meta is not None:
                cml_row = df_cml_meta[df_cml_meta['cml_id'].astype(str) == cml_id_str]
                if len(cml_row) > 0:
                    freq = cml_row.iloc[0].get('frequency', None)
                    length = cml_row.iloc[0].get('length', None)
                    if freq is not None and length is not None:
                        length_km = length / 1000 if length > 1000 else length
                        length_unit = 'km' if length > 1000 else 'm'
                        label = f'f={freq:.0f}MHz, L={length_km:.1f}{length_unit}' if length > 1000 else f'f={freq:.0f}MHz, L={length:.0f}{length_unit}'
            
            # Choose color and line width
            if is_emphasized:
                plot_color = 'cyan'
                lw = linewidth_emphasized
                alpha = 0.95
            else:
                plot_color = colors[i % 10]
                lw = linewidth
                alpha = 0.85
            
            ax.plot(data.index, data.values, lw=lw, alpha=alpha, 
                   color=plot_color, label=label if plotted_count < 10 else None)
            plotted_count += 1
    
    # Event day shading (only if event_day provided)
    if event_day is not None:
        ax.axvspan(event_day, event_day + pd.Timedelta(days=1), alpha=0.06, color=event_color)
    
    ax.axhline(0, color='k', lw=0.5, alpha=0.8)
    ylabel = 'Attenuation (dB)' if signal_type == 'attenuation' else 'RSL (dBm)'
    ax.set_ylabel(ylabel, fontweight='bold', fontsize=15)
    ax.set_title(f'CML {signal_type.upper()}', fontweight='bold', loc='left', fontsize=16)
    ax.grid(True, alpha=0.25, linewidth=0.5)
    if plotted_count <= 10:
        ax.legend(loc='upper right', fontsize=12, ncol=2)


def _plot_snow_depth(ax, snow_depth_data, window_start, window_end, event_day=None, 
                     station='BKLN', snow_data=None, event_color='red', 
                     all_params=None, resample_interval=None):
    """Plot snow depth with stats."""
    mesonet = None
    if all_params is not None:
        snow_processed = all_params.get('snow_processed', {})
        if 'mesonet' in snow_processed:
            mesonet = snow_processed['mesonet']
    
    if mesonet is None:
        mesonet = snow_depth_data.get('mesonet')
    
    if mesonet is not None and station in mesonet.columns:
        data = mesonet[station].loc[window_start:window_end]
        if resample_interval is not None and len(data) > 0:
            data = data.resample(resample_interval).mean()
        if len(data) > 0:
            label = 'Mesonet (processed)' if all_params and 'snow_processed' in all_params and 'mesonet' in all_params.get('snow_processed', {}) else 'Mesonet'
            ax.plot(data.index, data.values, lw=2, color='#1f77b4', 
                   marker='o', markersize=2, label=label)
    
    if event_day is not None:
        ax.axvspan(event_day, event_day + pd.Timedelta(days=1), alpha=0.06, color=event_color)
        stats = _get_day_stats(event_day, snow_depth_data, snow_data, station)
        if stats:
            ax.text(0.02, 0.98, '\n'.join(stats), transform=ax.transAxes, fontsize=11,
                    va='top', bbox=dict(boxstyle='round', facecolor='lightblue', alpha=0.8))
    
    ax.axhline(0, color='k', lw=0.5, alpha=0.8)
    ax.set_ylabel('Snow Depth (mm)', fontweight='bold', fontsize=15)
    ax.set_title(f'Snow Depth ({station})', fontweight='bold', loc='left', fontsize=16)
    ax.grid(True, alpha=0.25, linewidth=0.5)
    ax.legend(loc='upper right', fontsize=12)


def _plot_temperature(ax, temp_data, window_start, window_end, event_day=None, 
                      event_color='red', resample_interval=None):
    """Plot temperature."""
    plotted = False
    
    for source in ['asos_1min', 'mesonet']:
        if source in temp_data and not plotted:
            df = temp_data[source]
            data = df.loc[window_start:window_end]
            if resample_interval is not None and len(data) > 0:
                data = data.resample(resample_interval).mean()
            if len(data) > 0:
                for col in data.columns[:4]:
                    ax.plot(data.index, data[col], lw=1.5, alpha=0.8, label=col)
                plotted = True
    
    if event_day is not None:
        ax.axvspan(event_day, event_day + pd.Timedelta(days=1), alpha=0.06, color=event_color)
    
    ax.axhline(0, color='blue', ls='--', lw=1, alpha=0.5)
    ax.set_ylabel('Temperature (°C)', fontweight='bold', fontsize=15)
    ax.set_title('Temperature', fontweight='bold', loc='left', fontsize=16)
    ax.grid(True, alpha=0.25, linewidth=0.5)
    ax.legend(loc='upper right', fontsize=12, ncol=2)


def _plot_scatter_cml_vs_pws(ax, df_cml_dict, precip_data, window_start, window_end,
                              event_day=None, event_color='red', signal_type='attenuation',
                              df_cml_meta=None, pws_stations=None, cml_to_pws_map=None,
                              resample_interval=None, pl_params=None, aligned_data=None):
    """
    Scatter plot: X = PWS precipitation (mm/h), Y = CML-derived rain rate via power law (mm/h).
    
    Each dot is one time step for one CML, matched to its nearest PWS mean.
    If aligned_data is provided, uses pre-resampled data (no redundant resampling).
    """
    use_aligned = aligned_data is not None
    
    if use_aligned:
        pl_params = aligned_data['pl_params']
    else:
        if df_cml_meta is None:
            ax.text(0.5, 0.5, 'Scatter requires df_cml_meta', transform=ax.transAxes,
                    ha='center', va='center', fontsize=14, color='gray')
            return
        if pl_params is None:
            pl_params = _get_power_law_params_for_cmls(df_cml_dict, df_cml_meta)
    
    if len(pl_params) == 0:
        ax.text(0.5, 0.5, 'No power-law params (check freq/length in metadata)',
                transform=ax.transAxes, ha='center', va='center', fontsize=12, color='gray')
        return
    
    # --- Get PWS precipitation rate (mm/h) ---
    pws_rate = None
    
    if use_aligned:
        pws_rate_src = aligned_data.get('precip_rate_mean', {}).get('pws')
        if pws_rate_src is not None:
            pws_rate = pws_rate_src.loc[window_start:window_end]
    else:
        pws_precip = None
        if 'pws' in precip_data:
            df_pws = precip_data['pws']
            data_pws = df_pws.loc[window_start:window_end]
            
            if pws_stations is not None and len(pws_stations) > 0:
                available = [s for s in pws_stations if s in data_pws.columns]
                if len(available) > 0:
                    data_pws = data_pws[available]
                else:
                    data_pws = pd.DataFrame()
            
            if len(data_pws) > 0:
                if resample_interval is not None:
                    data_pws = data_pws.resample(resample_interval).sum()
                pws_precip = data_pws.mean(axis=1)
        
        if pws_precip is not None and not pws_precip.empty:
            if resample_interval is not None:
                _ri_minutes = pd.Timedelta(resample_interval).total_seconds() / 60
                if _ri_minutes < 60:
                    pws_rate = pws_precip * (60.0 / _ri_minutes)
                else:
                    pws_rate = pws_precip
            else:
                pws_rate = pws_precip * 60.0
    
    if pws_rate is None or pws_rate.empty:
        ax.text(0.5, 0.5, 'No PWS precip data in window', transform=ax.transAxes,
                ha='center', va='center', fontsize=12, color='gray')
        return
    
    # --- Build scatter points ---
    all_pws_x = []
    all_cml_y = []
    all_colors = []
    cml_colors = plt.cm.tab10(np.linspace(0, 1, min(len(pl_params), 10)))
    
    if use_aligned:
        cml_R = aligned_data['cml_R'].loc[window_start:window_end]
        for color_idx, cml_key in enumerate(pl_params.keys()):
            if cml_key not in cml_R.columns:
                continue
            R_series = cml_R[cml_key].dropna()
            if R_series.empty:
                continue
            
            common_idx = R_series.index.intersection(pws_rate.index)
            if len(common_idx) == 0:
                continue
            
            pws_vals = pws_rate.loc[common_idx].values
            r_vals = R_series.loc[common_idx].values
            mask = (pws_vals > 0) | (r_vals > 0)
            if mask.sum() == 0:
                continue
            
            all_pws_x.extend(pws_vals[mask])
            all_cml_y.extend(r_vals[mask])
            all_colors.extend([cml_colors[color_idx % 10]] * mask.sum())
    else:
        for color_idx, (cml_key, params) in enumerate(pl_params.items()):
            df = df_cml_dict.get(cml_key)
            if df is None or df.empty or signal_type not in df.columns:
                continue
            
            atten = df.loc[window_start:window_end, signal_type]
            if atten.empty or atten.isna().all():
                continue
            
            if resample_interval is not None:
                atten = atten.resample(resample_interval).mean()
            
            R_est = _calc_R_from_A(atten.values, params['L_km'], params['a'], params['b'])
            
            common_idx = atten.index.intersection(pws_rate.index)
            if len(common_idx) == 0:
                continue
            
            pws_vals = pws_rate.loc[common_idx].values
            r_vals = R_est[np.isin(atten.index, common_idx)]
            
            mask = (pws_vals > 0) | (r_vals > 0)
            if mask.sum() == 0:
                continue
            
            all_pws_x.extend(pws_vals[mask])
            all_cml_y.extend(r_vals[mask])
            all_colors.extend([cml_colors[color_idx % 10]] * mask.sum())
    
    if len(all_pws_x) == 0:
        ax.text(0.5, 0.5, 'No overlapping non-zero data', transform=ax.transAxes,
                ha='center', va='center', fontsize=12, color='gray')
        return
    
    all_pws_x = np.array(all_pws_x)
    all_cml_y = np.array(all_cml_y)
    
    # --- Plot scatter ---
    ax.scatter(all_pws_x, all_cml_y, c=all_colors, s=30, alpha=0.6, edgecolors='k', linewidths=0.3, zorder=3)
    
    # 1:1 line
    max_val = max(np.nanmax(all_pws_x), np.nanmax(all_cml_y)) if len(all_pws_x) > 0 else 10
    ax.plot([0, max_val * 1.2], [0, max_val * 1.2], 'k--', lw=1.5, alpha=0.5, label='1:1 line', zorder=1)
    
    # Stats
    valid = np.isfinite(all_pws_x) & np.isfinite(all_cml_y) & (all_pws_x > 0) & (all_cml_y > 0)
    if valid.sum() > 2:
        corr = np.corrcoef(all_pws_x[valid], all_cml_y[valid])[0, 1]
        bias = np.mean(all_cml_y[valid] - all_pws_x[valid])
        rmse = np.sqrt(np.mean((all_cml_y[valid] - all_pws_x[valid])**2))
        stats_text = f'n={valid.sum()}\nr={corr:.2f}\nbias={bias:.2f}\nRMSE={rmse:.2f}'
        ax.text(0.03, 0.97, stats_text, transform=ax.transAxes, fontsize=11,
                va='top', ha='left', bbox=dict(boxstyle='round', facecolor='lightyellow', alpha=0.9))
    
    n_cmls = len(pl_params)
    example = list(pl_params.values())[0]
    ax.set_xlabel('PWS Precipitation (mm/h)', fontweight='bold', fontsize=15)
    ax.set_ylabel('CML Power-Law R (mm/h)', fontweight='bold', fontsize=15)
    ax.set_title(f'CML vs PWS Scatter ({n_cmls} CMLs, f≈{example["f_GHz"]:.0f} GHz)',
                fontweight='bold', loc='left', fontsize=16)
    ax.grid(True, alpha=0.25, linewidth=0.5)
    ax.legend(loc='lower right', fontsize=12)
    ax.set_xlim(0, None)
    ax.set_ylim(0, None)


def _set_robust_ylim(ax, quantile=0.999, padding=1.3, min_ymax=0.2):
    """
    Set y-axis limits using a quantile of the plotted data to clip outlier spikes.
    
    Collects all y-values currently on the axes (lines + bar patches),
    computes the given quantile, and sets ylim to (0, q * padding).
    Falls back to (0, min_ymax) if no data or all zeros.
    """
    all_vals = []
    # Collect from line plots
    for line in ax.get_lines():
        ydata = line.get_ydata()
        if hasattr(ydata, '__len__') and len(ydata) > 0:
            vals = np.array(ydata, dtype=float)
            vals = vals[np.isfinite(vals) & (vals > 0)]
            if len(vals) > 0:
                all_vals.extend(vals)
    # Collect from bar plots
    for container in ax.containers:
        for bar in container:
            h = bar.get_height()
            if np.isfinite(h) and h > 0:
                all_vals.append(h)
    
    if len(all_vals) > 0:
        q_val = np.quantile(all_vals, quantile)
        ymax = max(q_val * padding, min_ymax)
    else:
        ymax = min_ymax
    
    ax.set_ylim(0, ymax)


def _plot_precip(ax, precip_data, window_start, window_end, event_day=None, 
                 station='BKLN', sources='all', event_color='red',
                 pws_stations=None, resample_interval=None):
    """Plot precipitation from specified sources."""
    
    # Determine bar width based on resample interval
    _bar_width = 0.015  # default ~20 min in date units
    if resample_interval is not None:
        _ri_map = {'1min': 0.002, '5min': 0.008, '10min': 0.012, '15min': 0.015, 
                   '30min': 0.025, '1H': 0.04, '1h': 0.04}
        _bar_width = _ri_map.get(resample_interval, 0.015)
    
    if sources in ['all', 'official']:
        # Mesonet
        if 'mesonet' in precip_data:
            df = precip_data['mesonet']
            if station in df.columns:
                data = df[station].loc[window_start:window_end]
                if resample_interval is not None and len(data) > 0:
                    data = data.resample(resample_interval).sum()
                if len(data) > 0:
                    ax.bar(data.index, data.values, width=_bar_width, color='green', 
                          alpha=0.8, label=f'Mesonet ({station})', edgecolor='darkgreen', linewidth=0.5)
        
        # ASOS
        if 'asos_1min' in precip_data:
            df = precip_data['asos_1min']
            data = df.loc[window_start:window_end].mean(axis=1)
            if resample_interval is not None and len(data) > 0:
                data = data.resample(resample_interval).sum()
            if len(data) > 0:
                ax.bar(data.index, data.values, width=_bar_width, color='orange', 
                      alpha=0.85, label='ASOS (mean)', edgecolor='darkorange', linewidth=0.5)
    
    if sources in ['all', 'pws']:
        if 'pws' in precip_data:
            df = precip_data['pws']
            data = df.loc[window_start:window_end]
            
            if pws_stations is not None and len(pws_stations) > 0:
                available_stations = [s for s in pws_stations if s in data.columns]
                if len(available_stations) > 0:
                    data = data[available_stations]
                else:
                    data = pd.DataFrame()
            
            if len(data) > 0:
                if resample_interval is not None:
                    data = data.resample(resample_interval).sum()
                
                pws_colors = plt.cm.Set2(np.linspace(0, 1, len(data.columns)))
                for i, col in enumerate(data.columns):
                    ax.plot(data.index, data[col].values, 
                           color=pws_colors[i % len(pws_colors)],
                           linewidth=1.5, alpha=0.5, 
                           label=col if len(data.columns) <= 5 else None)
                
                mean_pws = data.mean(axis=1)
                median_pws = data.median(axis=1)
                n_stations = len(data.columns)
                ax.plot(mean_pws.index, mean_pws.values, 
                       color='purple', linewidth=3, alpha=0.9,
                       label=f'PWS Mean (n={n_stations})')
                ax.plot(median_pws.index, median_pws.values, 
                       color='darkviolet', linewidth=2, alpha=0.7, linestyle='--',
                       label=f'PWS Median (n={n_stations})')
    
    if event_day is not None:
        ax.axvspan(event_day, event_day + pd.Timedelta(days=1), alpha=0.06, color=event_color)
    
    title_map = {'all': 'All Sources', 'official': 'Official (NOAA/Mesonet)', 'pws': 'PWS'}
    ax.set_ylabel('Precip (mm)', fontweight='bold', fontsize=15)
    ax.set_title(f'Precipitation ({title_map.get(sources, sources)})', fontweight='bold', loc='left', fontsize=16)
    ax.grid(True, alpha=0.25, linewidth=0.5)
    ax.legend(loc='upper right', fontsize=12)
    # Robust y-axis: use 98th percentile to clip outlier spikes
    _set_robust_ylim(ax, quantile=0.98, padding=1.3)


