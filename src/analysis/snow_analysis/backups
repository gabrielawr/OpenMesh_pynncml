def plot_weather_clean(df_asos_type, rainy_days, snowy_days):
    """3 Side-by-side histograms - CLEAN no warnings"""
    
    # Suppress pandas warnings
    pd.set_option('future.no_silent_downcasting', True)
    
    def get_percentages(df):
        all_values = df.stack().dropna()
        types = sorted(all_values.unique())
        
        # Float dtype from start
        pct = pd.DataFrame(0.0, index=types, columns=df.columns)
        
        for sensor in df.columns:
            counts = df[sensor].value_counts()
            total = counts.sum()
            for w_type in types:
                if w_type in counts:
                    pct.loc[w_type, sensor] = round(counts[w_type] / total * 100, 2)
        
        return pct
    
    # Calculate
    pct_all = get_percentages(df_asos_type)
    rainy_mask = df_asos_type.index.normalize().isin([d.normalize() for d in rainy_days])
    pct_rainy = get_percentages(df_asos_type[rainy_mask])
    snowy_mask = df_asos_type.index.normalize().isin([d.normalize() for d in snowy_days])
    pct_snowy = get_percentages(df_asos_type[snowy_mask])
    
    # 3x1 SUBPLOT
    fig, axes = plt.subplots(1, 3, figsize=(18, 6))
    titles = ['ALL DATA', f'RAINY (n={len(rainy_days)})', f'SNOWY (n={len(snowy_days)})']
    
    for ax, title, pct_data in zip(axes, titles, [pct_all, pct_rainy, pct_snowy]):
        types = pct_data.index
        x_pos = range(len(df_asos_type.columns))
        width = 0.75 / len(types)
        
        bottom = [0] * 3
        colors = plt.cm.tab10(range(len(types)))
        
        for i, w_type in enumerate(types):
            heights = pct_data.loc[w_type].values
            bars = ax.bar([j + i*width for j in x_pos], heights, width,
                         bottom=bottom, label=w_type, color=colors[i])
            bottom = [b + h for b, h in zip(bottom, heights)]
            
            for j, bar in enumerate(bars):
                h = bar.get_height()
                if h >= 1:
                    ax.text(bar.get_x() + bar.get_width()/2., bar.get_y() + h/2.,
                           f'{h:.1f}%', ha='center', va='center', fontweight='bold')
        
        ax.set_title(title)
        ax.set_xticks([j + (len(types)-1)*width/2 for j in x_pos])
        ax.set_xticklabels(df_asos_type.columns)
        ax.grid(axis='y', alpha=0.3)
    
    plt.suptitle('Weather Distribution: All | Rainy | Snowy', fontsize=16, fontweight='bold')
    plt.tight_layout()
    plt.show()
    
    # Clean table
    summary = pd.DataFrame({
        'Type': pct_all.index,
        'All': pct_all.mean(axis=1).round(2),
        'Rainy': pct_rainy.mean(axis=1).round(2),
        'Snowy': pct_snowy.mean(axis=1).round(2)
    })
    print("\n📊 % Distribution (2 decimals):")
    print(summary.to_string(index=False))
    
    return fig


def plot_precipitation_accumulation(
    precip_data: Dict[str, pd.DataFrame],
    rainy_days: List[pd.Timestamp] = None,
    snowy_days: List[pd.Timestamp] = None,
    start_date: pd.Timestamp = None,
    end_date: pd.Timestamp = None,
    mode: str = "separate",  # "separate" = subplots per source, "merged" = all on one plot
    figsize_separate: tuple = (18, 12),
    figsize_merged: tuple = (14, 7)
):
    """
    Plot precipitation accumulation for multiple sources, either:
    - mode="separate": subplots per source (PWS / ASOS 1min / NOAA daily / Mesonet)
    - mode="merged"  : one plot where all sources (mean/median only) on same graph.

    Parameters
    ----------
    precip_data : dict
        Keys like: 'pws', 'asos_1min', 'noaa_daily', 'mesonet'
        Each value is DataFrame with columns=stations, index=time, incremental precipitation.
    rainy_days, snowy_days : list of Timestamps, optional
        Days to highlight with colored background grids.
    start_date, end_date : Timestamps, optional
        Date range to filter.
    mode : {"separate", "merged"}
        separate - multiple subplots.
        merged   - single plot with mean/median only.
    """

    # Filter date range if provided
    if start_date is not None or end_date is not None:
        filtered_data = {}
        for source, df in precip_data.items():
            if df is None or len(df) == 0:
                continue
            mask = pd.Series(True, index=df.index)
            if start_date is not None:
                mask &= (df.index >= start_date)
            if end_date is not None:
                mask &= (df.index <= end_date)
            filtered_data[source] = df[mask]
        precip_data = filtered_data

    # Normalize rainy/snowy days
    if rainy_days is not None:
        rainy_days = [pd.Timestamp(d).normalize() for d in rainy_days]
    if snowy_days is not None:
        snowy_days = [pd.Timestamp(d).normalize() for d in snowy_days]

    # =====================================================================
    # Mode 1: All sources on single plot (merged) - MEAN/MEDIAN ONLY
    # =====================================================================
    if mode == "merged":
        fig, ax = plt.subplots(figsize=figsize_merged)

        # Get global time range
        all_indices = [df.index for df in precip_data.values() if df is not None and len(df) > 0]
        if all_indices:
            global_min = min(idx.min() for idx in all_indices)
            global_max = max(idx.max() for idx in all_indices)

            # Draw colored background grids for event days (BEFORE plotting data)
            if rainy_days:
                for day in rainy_days:
                    day_start = day.normalize()
                    day_end = day_start + pd.Timedelta(days=1)
                    if day_start <= global_max and day_end >= global_min:
                        ax.axvspan(day_start, day_end, 
                                  color="lightblue", alpha=0.15, zorder=0,
                                  label="Rain Days" if day == rainy_days[0] else "")

            if snowy_days:
                for day in snowy_days:
                    day_start = day.normalize()
                    day_end = day_start + pd.Timedelta(days=1)
                    if day_start <= global_max and day_end >= global_min:
                        ax.axvspan(day_start, day_end, 
                                  color="lightcyan", alpha=0.2, zorder=0,
                                  label="Snow Days" if day == snowy_days[0] else "")

        # Plot data lines (on top of colored backgrounds)
        for source, df in precip_data.items():
            if df is None or len(df) == 0:
                continue

            df_accum = df.fillna(0).cumsum()

            if source == "pws":
                mean_accum = df_accum.mean(axis=1)
                ax.plot(mean_accum.index, mean_accum.values,
                       color="blue", linewidth=3, label="PWS Mean", zorder=10)
                
                median_accum = df_accum.median(axis=1)
                ax.plot(median_accum.index, median_accum.values,
                       color="navy", linewidth=2.5, linestyle="--", label="PWS Median", zorder=10)

            elif source == "asos_1min":
                mean_accum = df_accum.mean(axis=1)
                ax.plot(mean_accum.index, mean_accum.values,
                       color="orange", linewidth=3, label="ASOS 1min Mean", zorder=9)

            elif source == "noaa_daily":
                mean_accum = df_accum.mean(axis=1)
                ax.plot(mean_accum.index, mean_accum.values,
                       color="green", linewidth=3, marker="o", markersize=4,
                       label="ASOS Daily Mean", zorder=9)

            elif source == "mesonet":
                mean_accum = df_accum.mean(axis=1)
                ax.plot(mean_accum.index, mean_accum.values,
                       color="purple", linewidth=3, label="Mesonet Mean", zorder=9)

        ax.set_xlabel("Date", fontsize=12)
        ax.set_ylabel("Cumulative Precipitation (mm)", fontsize=12)
        ax.set_title("Precipitation Accumulation - All Sources (Mean/Median)", 
                    fontsize=14, fontweight="bold")
        ax.grid(True, alpha=0.3, linestyle="-", linewidth=0.5)
        ax.xaxis.set_major_formatter(mdates.DateFormatter("%Y-%m-%d"))
        ax.xaxis.set_major_locator(mdates.AutoDateLocator())
        plt.xticks(rotation=45)
        
        # Clean legend
        handles, labels = ax.get_legend_handles_labels()
        uniq = dict(zip(labels, handles))
        ax.legend(uniq.values(), uniq.keys(), loc="upper left", fontsize=11)
        
        # Auto y-limits with padding
        ax.margins(x=0.01, y=0.1)
        plt.tight_layout()
        plt.show()
        print("✓ Precipitation accumulation merged plot (means only) completed")
        return fig
    # =====================================================================
    # Mode 2: Separate subplots per source
    # =====================================================================
    
    # Determine active sources
