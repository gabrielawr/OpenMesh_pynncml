def _plot_precip_type(ax, ptype_data, window_start, window_end, event_day, 
                      event_color='red'):
    """
    Plot precipitation type as horizontal color bands per station.
    
    Each station gets a horizontal "lane" showing precip type over time.
    """
    
    type_colors = {
        'dry': 'none',
        'rain': 'blue', 
        'snow': 'cyan',
        'mix': 'gray',
        'unknown': 'lightgray',
    }
    
    # Get ASOS ptype data - key is 'asos_1min'
    df_type = ptype_data.get('asos_1min')
    if df_type is None:
        ax.text(0.5, 0.5, 'No ptype data', transform=ax.transAxes, 
                ha='center', va='center', fontsize=12, color='gray')
        ax.set_ylabel('Precip Type')
        return
    
    # Filter to window
    mask = (df_type.index >= window_start) & (df_type.index <= window_end)
    df_plot = df_type.loc[mask]
    
    if len(df_plot) == 0:
        ax.text(0.5, 0.5, 'No data in window', transform=ax.transAxes,
                ha='center', va='center', fontsize=12, color='gray')
        return
    
    stations = df_plot.columns.tolist()
    n_stations = len(stations)
    
    # Normalize y-axis: each station gets equal slice of 0-1
    lane_height = 1.0 / n_stations
    
    for i, station in enumerate(stations):
        y_bottom = i * lane_height
        y_top = (i + 0.9) * lane_height  # Small gap between lanes
        
        ptype_series = df_plot[station]
        
        # Draw colored spans for each type period
        for idx in range(len(ptype_series) - 1):
            t_start = ptype_series.index[idx]
            t_end = ptype_series.index[idx + 1]
            type_val = ptype_series.iloc[idx]
            
            if pd.isna(type_val) or type_val == 'dry':
                continue
            
            color = type_colors.get(type_val, 'lightgray')
            if color == 'none':
                continue
                
            ax.fill_between([t_start, t_end], y_bottom, y_top,
                           color=color, alpha=0.6, linewidth=0)
    
    # Event day shading
    ax.axvspan(event_day, event_day + pd.Timedelta(days=1), 
               alpha=0.15, color=event_color, zorder=0)
    
    # Y-axis: station names, limit 0-1
    ax.set_ylim(0, 1)
    ax.set_yticks([(i + 0.45) * lane_height for i in range(n_stations)])
    ax.set_yticklabels([s.replace('1min_', '') for s in stations], fontsize=10)
    
    # Legend
    from matplotlib.patches import Patch
    legend_elements = [
        Patch(facecolor='cyan', alpha=0.6, label='Snow'),
        Patch(facecolor='blue', alpha=0.6, label='Rain'),
        Patch(facecolor='gray', alpha=0.6, label='Mix'),
    ]
    ax.legend(handles=legend_elements, loc='upper right', fontsize=9, ncol=3)
    
    ax.set_ylabel('Precip Type', fontweight='bold')
    ax.set_title('Precip Type (ASOS)', fontweight='bold', loc='left')
    ax.grid(True, alpha=0.3, axis='x')

