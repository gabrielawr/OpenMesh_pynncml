def plot_attenuation_vs_rainfall_scatter(result: Dict, cml_metadata: pd.DataFrame = None,
                                          resample_interval: str = '15min'):
    """
    Plot scatter: attenuation vs rainfall.
    
    ROW 1: All sublinks merged per rainfall source (3 subplots)
           - Each subplot = one rainfall source (ASOS, Mesonet BKLN, PWS mean)
           - Different colors for different sublinks
    
    ROW 2: Each sublink separate (N subplots)
           - Each subplot = one sublink
           - Different colors for different rainfall sources
    """
    cml_data, weather, date = result['cml_data'], result['weather'], result['date']
    cml_id = result['cml_id']
    window_start, window_end = weather['window']
    
    # Filter to valid sublinks only
    valid_sublinks = {k: df for k, df in cml_data.items() 
                      if df is not None and len(df) > 0 and 'attenuation' in df.columns
                      and not df['attenuation'].isna().all()}
    
    if not valid_sublinks:
        print("⚠ No valid sublink data for scatter plot")
        return
    
    # Print metadata table
    valid_sublinks = print_sublink_metadata_table(cml_data, cml_metadata, cml_id)
    
    interval_minutes = int(resample_interval.replace('min', '').replace('T', ''))
    
    def convert_to_mmh(df, orig_min=1):
        if df is None or len(df) == 0:
            return None
        df_res = df.resample(resample_interval).sum()
        return df_res / (interval_minutes / 60.0)
    
    # =========================================================================
    # PREPARE RAINFALL DATA
    # =========================================================================
    rainfall_sources = {}
    
    # ASOS (mean)
    if 'asos_1min' in weather['precip']:
        df = weather['precip']['asos_1min'].loc[window_start:window_end]
        if len(df) > 0:
            converted = convert_to_mmh(df)
            if converted is not None and len(converted) > 0:
                rainfall_sources['ASOS (mean)'] = converted.mean(axis=1)
    
    # Mesonet BKLN
    if 'mesonet' in weather['precip']:
        df = weather['precip']['mesonet'].loc[window_start:window_end]
        if len(df) > 0 and 'BKLN' in df.columns:
            converted = convert_to_mmh(df[['BKLN']])
            if converted is not None and len(converted) > 0:
                rainfall_sources['Mesonet BKLN'] = converted['BKLN']
    
    # PWS (mean)
    if len(weather['pws']) > 0:
        df = weather['pws'].loc[window_start:window_end]
        if len(df) > 0:
            converted = convert_to_mmh(df)
            if converted is not None and len(converted) > 0:
                rainfall_sources['PWS (mean)'] = converted.mean(axis=1)
    
    if not rainfall_sources:
        print("⚠ No rainfall data for scatter plot")
        return
    
    # =========================================================================
    # PREPARE ATTENUATION DATA (with interpolation tracking)
    # =========================================================================
    attenuation_data = {}
    interpolated_data = {}  # Track which points are interpolated
    sublink_colors = plt.cm.tab10(np.linspace(0, 1, len(valid_sublinks)))
    sublink_color_map = {}
    
    for i, (key, df) in enumerate(sorted(valid_sublinks.items())):
        # Resample attenuation
        atten = df[['attenuation']].resample(resample_interval).mean()['attenuation']
        atten = atten.loc[window_start:window_end]
        
        # Resample interpolation mask (any True in interval = True)
        if 'is_interpolated' in df.columns:
            interp_mask = df[['is_interpolated']].resample(resample_interval).max()['is_interpolated']
            interp_mask = interp_mask.loc[window_start:window_end].fillna(False).astype(bool)
        else:
            interp_mask = pd.Series(False, index=atten.index)
        
        if len(atten) > 0 and not atten.isna().all():
            attenuation_data[key] = atten
            interpolated_data[key] = interp_mask
            sublink_color_map[key] = sublink_colors[i]
    
    if not attenuation_data:
        print("⚠ No valid attenuation data for scatter plot")
        return
    
    # =========================================================================
    # ROW 1: All sublinks merged, one subplot per rainfall source
    # =========================================================================
    n_sources = len(rainfall_sources)
    n_sublinks = len(attenuation_data)
    
    fig, axes = plt.subplots(2, max(n_sources, n_sublinks), figsize=(6 * max(n_sources, n_sublinks), 12))
    
    # Ensure 2D array
    if max(n_sources, n_sublinks) == 1:
        axes = axes.reshape(2, 1)
    
    # ROW 1
    rainfall_colors = {'ASOS (mean)': 'orange', 'Mesonet BKLN': 'green', 'PWS (mean)': 'purple'}
    
    for col, (source_name, rain_data) in enumerate(rainfall_sources.items()):
        ax = axes[0, col]
        
        for key, atten in attenuation_data.items():
            common = atten.index.intersection(rain_data.index)
            if len(common) > 0:
                sublink_idx = int(key.split('_')[-1])
                info = get_sublink_info(cml_metadata, cml_id, sublink_idx) if cml_metadata is not None else {}
                freq = info.get('frequency', '?')
                length = info.get('length', '?')
                label = f"SL{sublink_idx} ({freq:.0f}MHz)" if freq else f"SL{sublink_idx}"
                
                # Get interpolation mask for common times
                interp_mask = interpolated_data[key].loc[common] if key in interpolated_data else pd.Series(False, index=common)
                
                # Plot non-interpolated points (solid circles)
                non_interp = ~interp_mask
                if non_interp.any():
                    ax.scatter(rain_data.loc[common][non_interp].values, 
                              atten.loc[common][non_interp].values,
                              alpha=0.6, s=40, color=sublink_color_map[key], label=label, marker='o')
                
                # Plot interpolated points (red X markers)
                if interp_mask.any():
                    ax.scatter(rain_data.loc[common][interp_mask].values, 
                              atten.loc[common][interp_mask].values,
                              alpha=0.8, s=60, color='red', marker='x', 
                              label=f'{label} (interp)' if non_interp.sum() == 0 else None)
        
        ax.set_xlabel(f'{source_name} (mm/h)', fontsize=11, fontweight='bold')
        ax.set_ylabel('Attenuation (dB)', fontsize=11, fontweight='bold')
        ax.set_title(f'All Sublinks vs {source_name}', fontsize=12, fontweight='bold')
        ax.grid(True, alpha=0.3)
        ax.legend(fontsize=9, loc='upper left')
    
    # Hide unused subplots in row 1
    for col in range(n_sources, max(n_sources, n_sublinks)):
        axes[0, col].axis('off')
    
    # =========================================================================
    # ROW 2: Each sublink separate, all rainfall sources in different colors
    # =========================================================================
    for col, (key, atten) in enumerate(sorted(attenuation_data.items())):
        ax = axes[1, col]
        sublink_idx = int(key.split('_')[-1])
        info = get_sublink_info(cml_metadata, cml_id, sublink_idx) if cml_metadata is not None else {}
        freq = info.get('frequency', '?')
        length = info.get('length', '?')
        
        # Get interpolation mask for this sublink
        interp_mask_full = interpolated_data.get(key, pd.Series(False, index=atten.index))
        
        for source_name, rain_data in rainfall_sources.items():
            common = atten.index.intersection(rain_data.index)
            if len(common) > 0:
                # Get interpolation mask for common times
                interp_mask = interp_mask_full.loc[common] if len(interp_mask_full) > 0 else pd.Series(False, index=common)
                
                # Plot non-interpolated points (solid circles)
                non_interp = ~interp_mask
                if non_interp.any():
                    ax.scatter(rain_data.loc[common][non_interp].values, 
                              atten.loc[common][non_interp].values,
                              alpha=0.6, s=40, color=rainfall_colors.get(source_name, 'gray'),
                              label=source_name, marker='o')
                
                # Plot interpolated points (same color but X marker)
                if interp_mask.any():
                    ax.scatter(rain_data.loc[common][interp_mask].values, 
                              atten.loc[common][interp_mask].values,
                              alpha=0.8, s=60, color='red', marker='x')
        
        ax.set_xlabel('Rainfall (mm/h)', fontsize=11, fontweight='bold')
        ax.set_ylabel('Attenuation (dB)', fontsize=11, fontweight='bold')
        title = f'Sublink {sublink_idx}: {freq:.0f}MHz, {length:.0f}m' if freq else f'Sublink {sublink_idx}'
        ax.set_title(title, fontsize=12, fontweight='bold')
        ax.grid(True, alpha=0.3)
        ax.legend(fontsize=9, loc='upper left')
    
    # Add legend note for interpolated points
    fig.text(0.99, 0.02, "Red X = interpolated (NaN filled with max nearby)", 
             fontsize=10, ha='right', va='bottom', style='italic', color='red')
    
    # Hide unused subplots in row 2
    for col in range(n_sublinks, max(n_sources, n_sublinks)):
        axes[1, col].axis('off')
    
    fig.suptitle(f'Attenuation vs Rainfall ({resample_interval}) — CML {cml_id} — {date.strftime("%Y-%m-%d")}',
                fontsize=14, fontweight='bold', y=0.995)
    plt.tight_layout()
    plt.show()


