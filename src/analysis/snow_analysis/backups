import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib.dates as mdates
from typing import Optional, List, Dict, Union, Tuple
import xarray as xr


def haversine_distance(lat1, lon1, lat2, lon2):
    """Calculate distance between two points in meters."""
    R = 6371000
    lat1_rad, lat2_rad = np.radians(lat1), np.radians(lat2)
    delta_lat, delta_lon = np.radians(lat2 - lat1), np.radians(lon2 - lon1)
    a = np.sin(delta_lat/2)**2 + np.cos(lat1_rad)*np.cos(lat2_rad)*np.sin(delta_lon/2)**2
    return R * 2 * np.arcsin(np.sqrt(a))


def get_cml_by_criteria(
    cml_metadata: pd.DataFrame,
    freq_range: Tuple[Optional[float], Optional[float]] = (None, None),
    length_range: Tuple[Optional[float], Optional[float]] = (None, None),
    cml_ids: Optional[List[str]] = None,
    verbose: bool = True,
) -> List[str]:
    """Get CML IDs matching frequency (MHz) and/or length (m) criteria."""
    df = cml_metadata.copy()
    
    freq_col = next((c for c in ['frequency', 'freq', 'Frequency'] if c in df.columns), None)
    len_col = next((c for c in ['length', 'Length', 'distance'] if c in df.columns), None)
    
    if freq_col and freq_range != (None, None):
        min_freq, max_freq = freq_range
        if min_freq is not None:
            df = df[df[freq_col] >= min_freq]
        if max_freq is not None:
            df = df[df[freq_col] <= max_freq]
    
    if len_col and length_range != (None, None):
        min_len, max_len = length_range
        if min_len is not None:
            df = df[df[len_col] >= min_len]
        if max_len is not None:
            df = df[df[len_col] <= max_len]
    
    if cml_ids is not None:
        df = df[df['cml_id'].astype(str).isin([str(x) for x in cml_ids])]
    
    result_ids = df['cml_id'].astype(str).unique().tolist()
    
    if verbose:
        print("=" * 70)
        print("CML SELECTION BY CRITERIA")
        print("=" * 70)
        print(f"Frequency range: {freq_range[0] or 'any'} - {freq_range[1] or 'any'} MHz")
        print(f"Length range: {length_range[0] or 'any'} - {length_range[1] or 'any'} m")
        print(f"Found: {len(result_ids)} CML links")
        if 0 < len(result_ids) <= 10:
            for cml_id in result_ids:
                row = cml_metadata[cml_metadata['cml_id'].astype(str) == str(cml_id)].iloc[0]
                freq = row[freq_col] if freq_col else 'N/A'
                length = row[len_col] if len_col else 'N/A'
                print(f"  • {cml_id}: {freq:.0f} MHz, {length:.0f} m")
        print("=" * 70 + "\n")
    
    return result_ids


def get_cml_info(cml_metadata: pd.DataFrame, cml_id: str) -> Dict:
    """Get CML link information."""
    cml_id_str = str(cml_id)
    cml_row = cml_metadata[cml_metadata['cml_id'].astype(str) == cml_id_str]
    if len(cml_row) == 0:
        raise ValueError(f"CML ID {cml_id} not found")
    cml_row = cml_row.iloc[0]
    
    freq_col = next((c for c in ['frequency', 'freq', 'Frequency'] if c in cml_metadata.columns), None)
    len_col = next((c for c in ['length', 'Length', 'distance'] if c in cml_metadata.columns), None)
    
    return {
        'cml_id': cml_id_str,
        'frequency': cml_row[freq_col] if freq_col else None,
        'length': cml_row[len_col] if len_col else None,
        'site_0': (cml_row['site_0_lat'], cml_row['site_0_lon']),
        'site_1': (cml_row['site_1_lat'], cml_row['site_1_lon']),
        'midpoint': ((cml_row['site_0_lat'] + cml_row['site_1_lat'])/2,
                     (cml_row['site_0_lon'] + cml_row['site_1_lon'])/2),
    }


def find_nearby_pws(cml_info: Dict, pws_metadata: pd.DataFrame,
                    max_distance_km: float = 5.0, n_nearest: int = 5) -> pd.DataFrame:
    """Find PWS stations near a CML link."""
    if pws_metadata is None or len(pws_metadata) == 0:
        return pd.DataFrame()
    
    mid_lat, mid_lon = cml_info['midpoint']
    distances = [haversine_distance(mid_lat, mid_lon, row['latitude'], row['longitude'])
                 for _, row in pws_metadata.iterrows()]
    
    pws_with_dist = pws_metadata.copy()
    pws_with_dist['distance_m'] = distances
    pws_with_dist = pws_with_dist.sort_values('distance_m')
    pws_within = pws_with_dist[pws_with_dist['distance_m'] <= max_distance_km * 1000]
    return pws_within.head(n_nearest)[['station_id', 'latitude', 'longitude', 'distance_m']].copy()


def get_sublink_info(cml_metadata: pd.DataFrame, cml_id: str, sublink_idx: int) -> Dict:
    """Get sublink-specific info."""
    cml_id_str = str(cml_id)
    sublink_id = f"sublink_{sublink_idx + 1}"
    
    mask = (cml_metadata['cml_id'].astype(str) == cml_id_str)
    if 'sublink_id' in cml_metadata.columns:
        mask = mask & (cml_metadata['sublink_id'] == sublink_id)
    
    rows = cml_metadata[mask]
    if len(rows) == 0:
        return {'frequency': None, 'length': None}
    
    row = rows.iloc[0]
    freq_col = next((c for c in ['frequency', 'freq', 'Frequency'] if c in cml_metadata.columns), None)
    len_col = next((c for c in ['length', 'Length', 'distance'] if c in cml_metadata.columns), None)
    
    return {
        'frequency': row[freq_col] if freq_col else None,
        'length': row[len_col] if len_col else None,
    }


def extract_cml_for_day(ds_cml: xr.Dataset, cml_id: str, date: pd.Timestamp,
                        sublinks: Union[str, int, List[int]] = 'all', window_hours: int = 12,
                        baseline_window: str = '6h', baseline_quantile: float = 0.99) -> Dict[str, pd.DataFrame]:
    """Extract CML data for a specific day."""
    cml_id_str = str(cml_id)
    day_start = pd.Timestamp(date).normalize()
    window_start = day_start - pd.Timedelta(hours=window_hours)
    window_end = day_start + pd.Timedelta(hours=window_hours + 24)
    
    all_sublinks = ds_cml.sublink_id.values
    if sublinks == 'all':
        sublinks_to_extract = list(range(len(all_sublinks)))
    elif isinstance(sublinks, int):
        sublinks_to_extract = [sublinks]
    else:
        sublinks_to_extract = list(sublinks)
    
    result = {}
    for sublink_idx in sublinks_to_extract:
        if sublink_idx >= len(all_sublinks):
            continue
        sublink_id = all_sublinks[sublink_idx]
        
        try:
            rsl_data = ds_cml.rsl.sel(cml_id=cml_id_str, sublink_id=sublink_id)
            df = pd.DataFrame({'rsl': rsl_data.values}, index=pd.to_datetime(rsl_data.time.values))
            df = df[(df.index >= window_start) & (df.index <= window_end)]
            
            if len(df) == 0:
                continue
            
            # Check if all values are NaN
            if df['rsl'].isna().all():
                continue
            
            df['baseline'] = df['rsl'].rolling(window=baseline_window, min_periods=1).quantile(baseline_quantile)
            df['attenuation'] = (df['baseline'] - df['rsl']).clip(lower=0)
            
            nan_mask = df['attenuation'].isna()
            if nan_mask.any():
                # Fill NaN with max attenuation from forward/backward window
                # First try forward fill, then backward fill using max of nearby values
                df['attenuation_filled'] = df['attenuation'].copy()
                
                # For each NaN, find max attenuation in a window around it
                window_size = 30  # 30 minutes window
                for idx in df.index[nan_mask]:
                    # Get window around the NaN point
                    start_idx = max(0, df.index.get_loc(idx) - window_size)
                    end_idx = min(len(df), df.index.get_loc(idx) + window_size)
                    window_data = df['attenuation'].iloc[start_idx:end_idx]
                    
                    # Use max of non-NaN values in window
                    valid_values = window_data.dropna()
                    if len(valid_values) > 0:
                        df.loc[idx, 'attenuation_filled'] = valid_values.max()
                    else:
                        # Fallback: use global max
                        global_max = df['attenuation'].max()
                        df.loc[idx, 'attenuation_filled'] = global_max if not pd.isna(global_max) else 0
                
                df['attenuation'] = df['attenuation_filled']
                df['is_interpolated'] = nan_mask
                df.drop(columns=['attenuation_filled'], inplace=True)
            else:
                df['is_interpolated'] = False
            
            result[f"{cml_id_str}_{sublink_idx}"] = df
        except Exception as e:
            print(f"  ⚠ Error extracting {cml_id_str} sublink {sublink_idx}: {e}")
    
    return result


def extract_weather_for_day(all_params: Dict, date: pd.Timestamp, window_hours: int = 12,
                            pws_station_ids: Optional[List[str]] = None) -> Dict:
    """Extract all weather data for a day window."""
    day_start = pd.Timestamp(date).normalize()
    window_start = day_start - pd.Timedelta(hours=window_hours)
    window_end = day_start + pd.Timedelta(hours=window_hours + 24)
    
    def filter_to_window(df):
        if df is None or len(df) == 0:
            return pd.DataFrame()
        return df[(df.index >= window_start) & (df.index <= window_end)].copy()
    
    result = {'window': (window_start, window_end), 'date': date,
              'snow_depth': {}, 'snow': {}, 'precip': {}, 'pws': pd.DataFrame(),
              'precip_type': pd.DataFrame(), 'temp': {}}
    
    for param in ['snow_depth', 'snow', 'precip', 'temp']:
        if param in all_params:
            for source, df in all_params[param].items():
                filtered = filter_to_window(df)
                if len(filtered) > 0:
                    result[param][source] = filtered
    
    if 'precip' in all_params and 'pws' in all_params['precip']:
        pws_all = filter_to_window(all_params['precip']['pws'])
        if len(pws_all) > 0:
            if pws_station_ids:
                available = [s for s in pws_station_ids if s in pws_all.columns]
                if available:
                    result['pws'] = pws_all[available]
            else:
                result['pws'] = pws_all
    
    if 'precip_type' in all_params and 'asos_1min' in all_params['precip_type']:
        result['precip_type'] = filter_to_window(all_params['precip_type']['asos_1min'])
    
    return result


def categorize_precip_type(ptype_str):
    """Categorize precipitation type."""
    if pd.isna(ptype_str) or ptype_str == '':
        return 'none'
    ptype_str = str(ptype_str).upper().strip()
    has_rain, has_snow = 'R' in ptype_str, 'S' in ptype_str
    if has_rain and has_snow:
        return 'mix'
    elif has_rain:
        return 'rain'
    elif has_snow:
        return 'snow'
    elif 'P' in ptype_str:
        return 'precip'
    return 'none'


def print_sublink_metadata_table(cml_data: Dict, cml_metadata: pd.DataFrame, cml_id: str):
    """Print a nice metadata table for valid sublinks."""
    valid_sublinks = {k: df for k, df in cml_data.items() 
                      if df is not None and len(df) > 0 and 'attenuation' in df.columns}
    
    if not valid_sublinks:
        print("  No valid sublinks found!")
        return valid_sublinks
    
    print("\n" + "=" * 60)
    print("SUBLINK METADATA")
    print("=" * 60)
    print(f"{'Sublink':<15} {'Freq (MHz)':<12} {'Length (m)':<12} {'Records':<10}")
    print("-" * 60)
    
    for key in sorted(valid_sublinks.keys()):
        df = valid_sublinks[key]
        sublink_idx = int(key.split('_')[-1])
        info = get_sublink_info(cml_metadata, cml_id, sublink_idx)
        freq = info['frequency']
        length = info['length']
        freq_str = f"{freq:.0f}" if freq else "N/A"
        len_str = f"{length:.0f}" if length else "N/A"
        print(f"{key:<15} {freq_str:<12} {len_str:<12} {len(df):<10}")
    
    print("=" * 60 + "\n")
    return valid_sublinks



def analyze_day(
    date: Union[str, pd.Timestamp],
    cml_id: Optional[str] = None,
    sublinks: Union[str, int, List[int]] = 'all',
    freq_range: Tuple[Optional[float], Optional[float]] = (None, None),
    length_range: Tuple[Optional[float], Optional[float]] = (None, None),
    pws_distance_km: float = 5.0,
    n_nearest_pws: int = 5,
    ds_cml: xr.Dataset = None,
    all_params: Dict = None,
    cml_metadata: pd.DataFrame = None,
    pws_metadata: pd.DataFrame = None,
    window_hours: int = 12,
    signal_type: str = 'attenuation',
    plot: bool = True,
    figsize: Tuple[int, int] = (20, 22),
) -> Dict:
    """Analyze a single day: CML + all associated weather data."""
    
    if ds_cml is None or all_params is None or cml_metadata is None:
        raise ValueError("ds_cml, all_params, and cml_metadata are required")
    
    date = pd.Timestamp(date).normalize()
    print("=" * 70)
    print(f"DAY ANALYSIS: {date.strftime('%Y-%m-%d (%A)')}")
    print("=" * 70)
    
    # 1. SELECT CML
    if cml_id is None:
        matching_ids = get_cml_by_criteria(cml_metadata, freq_range, length_range, verbose=True)
        cml_id = matching_ids[0] if matching_ids else str(cml_metadata['cml_id'].iloc[0])
    cml_id = str(cml_id)
    
    cml_info = get_cml_info(cml_metadata, cml_id)
    print(f"✓ CML: {cml_id} ({cml_info['frequency']:.0f} MHz, {cml_info['length']:.0f} m)")
    
    # 2. EXTRACT CML DATA
    print(f"\n[CML DATA]")
    cml_data = extract_cml_for_day(ds_cml, cml_id, date, sublinks, window_hours)
    print(f"✓ Extracted {len(cml_data)} sublink(s) with data")
    
    # 3. MATCH PWS
    print(f"\n[PWS MATCHING]")
    matched_pws = pd.DataFrame()
    pws_station_ids = []
    
    if pws_metadata is not None and len(pws_metadata) > 0:
        matched_pws = find_nearby_pws(cml_info, pws_metadata, pws_distance_km, n_nearest_pws)
        if len(matched_pws) > 0:
            pws_station_ids = matched_pws['station_id'].tolist()
            print(f"✓ Found {len(matched_pws)} PWS stations")
    
    # 4. EXTRACT WEATHER
    print(f"\n[WEATHER DATA]")
    weather = extract_weather_for_day(all_params, date, window_hours, pws_station_ids)
    
    # 5. BUILD RESULT
    result = {
        'date': date, 'cml_id': cml_id, 'cml_info': cml_info,
        'cml_data': cml_data, 'matched_pws': matched_pws,
        'weather': weather, 'signal_type': signal_type,
    }
    
    # 6. PLOT
    if plot:
        plot_day_analysis(result, figsize, cml_metadata)
    
    print("\n✓ ANALYSIS COMPLETE\n")
    return result


def plot_day_analysis(result: Dict, figsize: Tuple[int, int] = (20, 22),
                      cml_metadata: pd.DataFrame = None):
    """Plot multi-panel day analysis."""
    date = result['date']
    cml_id = result['cml_id']
    cml_info = result['cml_info']
    cml_data = result['cml_data']
    matched_pws = result['matched_pws']
    weather = result['weather']
    signal_type = result.get('signal_type', 'attenuation')
    
    # Filter to only valid sublinks
    valid_cml_data = {k: df for k, df in cml_data.items() 
                      if df is not None and len(df) > 0 and signal_type in df.columns}
    
    if not valid_cml_data:
        print("⚠ No valid CML data to plot!")
        return
    
    window_start, window_end = weather['window']
    day_start, day_end = date, date + pd.Timedelta(days=1)
    
    fig, axes = plt.subplots(6, 1, figsize=figsize, sharex=True)
    cml_colors = plt.cm.tab10(np.linspace(0, 1, max(len(valid_cml_data), 1)))
    pws_colors = plt.cm.Set2(np.linspace(0, 1, 8))
    
    # Daily summary
    daily_summary = []
    for key, source_dict, label in [
        ('precip', weather['precip'], 'Precip'),
        ('snow_depth', weather['snow_depth'], 'Snow Depth'),
        ('temp', weather['temp'], 'Temp')
    ]:
        if 'noaa_daily' in source_dict:
            df = source_dict['noaa_daily']
            day_mask = (df.index >= day_start) & (df.index < day_end)
            if day_mask.any():
                val = df[day_mask].mean().mean()
                unit = '°C' if key == 'temp' else 'mm'
                daily_summary.append(f"NOAA {label}: {val:.1f} {unit}")
    
    # Panel 1: CML Signal (only valid sublinks)
    ax = axes[0]
    for i, (key, df) in enumerate(valid_cml_data.items()):
        sublink_idx = int(key.split('_')[-1])
        if cml_metadata is not None:
            info = get_sublink_info(cml_metadata, cml_id, sublink_idx)
            freq, length = info['frequency'], info['length']
        else:
            freq, length = cml_info['frequency'], cml_info['length']
        
        label = f"Sublink {sublink_idx}: {freq:.0f}MHz, {length:.0f}m" if freq else f"Sublink {sublink_idx}"
        ax.plot(df.index, df[signal_type], color=cml_colors[i], linewidth=2, alpha=0.8, label=label)
        
        if 'is_interpolated' in df.columns and df['is_interpolated'].any():
            mask = df['is_interpolated']
            ax.scatter(df.index[mask], df[signal_type][mask], color='red', marker='x', s=50, zorder=5)
    
    ax.axvspan(day_start, day_end, alpha=0.15, color='yellow', zorder=0)
    ax.axhline(y=0, color='black', linestyle='-', linewidth=0.5, alpha=0.3)
    ax.set_title(f"CML {cml_id} - {signal_type.upper()}", fontsize=14, fontweight='bold', loc='left')
    ax.set_ylabel('Attenuation (dB)' if signal_type == 'attenuation' else 'RSL (dBm)', fontsize=12)
    ax.grid(True, alpha=0.3)
    ax.legend(loc='upper right', fontsize=10)
    
    # Panel 2: Snow Depth
    ax = axes[1]
    if 'mesonet' in weather['snow_depth']:
        for col in weather['snow_depth']['mesonet'].columns:
            df = weather['snow_depth']['mesonet']
            day_data = df[col][(df.index >= day_start) & (df.index < day_end)]
            max_val = day_data.max() if len(day_data) > 0 else 0
            ax.plot(df.index, df[col], linewidth=2, alpha=0.8, label=f"{col} (max: {max_val:.1f}mm)")
        ax.legend(loc='upper right', fontsize=10)
    else:
        ax.text(0.5, 0.5, 'No snow depth data', ha='center', va='center', transform=ax.transAxes)
    ax.axvspan(day_start, day_end, alpha=0.15, color='yellow', zorder=0)
    ax.set_title('Snow Depth (Mesonet)', fontsize=14, fontweight='bold', loc='left')
    ax.set_ylabel('Snow Depth (mm)', fontsize=12)
    ax.grid(True, alpha=0.3)
    
    # Panel 3: PWS
    ax = axes[2]
    if len(weather['pws']) > 0:
        for i, col in enumerate(weather['pws'].columns):
            df = weather['pws']
            day_data = df[col][(df.index >= day_start) & (df.index < day_end)]
            total = day_data.sum() if len(day_data) > 0 else 0
            dist = ""
            if len(matched_pws) > 0:
                d = matched_pws[matched_pws['station_id'] == col]
                if len(d) > 0:
                    dist = f"{d['distance_m'].values[0]:.0f}m, "
            ax.plot(df.index, df[col], color=pws_colors[i], linewidth=1.5, alpha=0.8,
                   label=f"{col} ({dist}total: {total:.1f}mm)")
        ax.legend(loc='upper right', fontsize=9)
    else:
        ax.text(0.5, 0.5, 'No PWS data', ha='center', va='center', transform=ax.transAxes)
    ax.axvspan(day_start, day_end, alpha=0.15, color='yellow', zorder=0)
    ax.set_title(f'PWS Precipitation', fontsize=14, fontweight='bold', loc='left')
    ax.set_ylabel('Precipitation (mm)', fontsize=12)
    ax.grid(True, alpha=0.3)
    
    # Panel 4: ASOS/Mesonet Precip
    ax = axes[3]
    source_colors = {'asos_1min': 'orange', 'mesonet': 'green'}
    plotted = False
    for source, df in weather['precip'].items():
        if source in ['pws', 'noaa_daily']:
            continue
        if len(df) > 0:
            for col in df.columns:
                day_data = df[col][(df.index >= day_start) & (df.index < day_end)]
                total = day_data.sum() if len(day_data) > 0 else 0
                ax.plot(df.index, df[col], color=source_colors.get(source, 'gray'),
                       linewidth=1.5, alpha=0.7, label=f"{source}: {col} (total: {total:.1f}mm)")
            plotted = True
    if plotted:
        ax.legend(loc='upper right', fontsize=9)
    else:
        ax.text(0.5, 0.5, 'No ASOS/Mesonet precip data', ha='center', va='center', transform=ax.transAxes)
    ax.axvspan(day_start, day_end, alpha=0.15, color='yellow', zorder=0)
    ax.set_title('Precipitation (ASOS/Mesonet)', fontsize=14, fontweight='bold', loc='left')
    ax.set_ylabel('Precipitation (mm)', fontsize=12)
    ax.grid(True, alpha=0.3)
    
    # Panel 5: Precip Type
    ax = axes[4]
    if len(weather['precip_type']) > 0:
        type_colors = {'rain': 'blue', 'snow': 'cyan', 'mix': 'purple'}
        for col_idx, col in enumerate(weather['precip_type'].columns):
            col_data = weather['precip_type'][col].dropna()
            if len(col_data) == 0:
                continue
            categories = col_data.apply(categorize_precip_type)
            for ptype, color in type_colors.items():
                mask = categories == ptype
                if mask.any():
                    ax.scatter(col_data.index[mask], [col_idx + 1] * mask.sum(), c=color, s=30, alpha=0.7)
        ax.set_yticks(range(1, len(weather['precip_type'].columns) + 1))
        ax.set_yticklabels(weather['precip_type'].columns)
        from matplotlib.patches import Patch
        ax.legend(handles=[Patch(facecolor=c, label=t.capitalize()) for t, c in type_colors.items()],
                 loc='upper right', fontsize=10)
    else:
        ax.text(0.5, 0.5, 'No precip type data', ha='center', va='center', transform=ax.transAxes)
    ax.axvspan(day_start, day_end, alpha=0.15, color='yellow', zorder=0)
    ax.set_title('Precipitation Type (ASOS)', fontsize=14, fontweight='bold', loc='left')
    ax.grid(True, alpha=0.3, axis='x')
    
