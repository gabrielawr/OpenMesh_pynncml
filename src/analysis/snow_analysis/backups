def plot_event_day_analysis(
    df_cml_dict,
    event_days=None,
    all_params=None,
    event_type='snow',
    signal_type='attenuation',
    station='BKLN',
    window_days=None,
    window_before='1D',
    window_after='1D',
    max_events=None,
    precip_mode='all',
    figsize=None,
    cml_to_pws_map=None,
    df_cml_meta=None,
    emphasize_cml_ids=None,
    resample_interval=None,
    start_dt=None,
    end_dt=None,
    panels='all',
    day_grid=True,
    # === NEW PARAMETERS ===
    aggregate=None,  # Time interval: '15min', '30min', '1H', etc. (same as resample_interval but clearer name)
    cml_linewidth=2.5,
    cml_linewidth_emphasized=4.0,
    scatter=False,  # Add CML-vs-PWS power-law scatter panel
    aligned_data=None,  # Output of resample_all(); passed to scatter panel
    # === VISUAL TUNING ===
    show_title=True,
    official_alpha=0.25,  # Alpha for ASOS/Mesonet bars (lower = less intense)
    label_size=18,
    ylabel_size=16,
    tick_size=14,
    legend_size=13,
    # === STATISTICS ===
    statistics=False,  # Return event statistics (precip type %, NaN % per CML)
):
    """
    Enhanced event day analysis plot.
    
    Parameters
    ----------
    df_cml_dict : dict
        {cml_key: DataFrame with signal data}
    event_days : list or DatetimeIndex
        List of event days. MUST BE A LIST even for single day: [snowy_days[0]]
    all_params : dict
        Contains 'precip', 'temp', 'precip_type', 'snow_depth' data
    event_type : str, default 'snow'
        'snow', 'rain', or 'custom'
    signal_type : str, default 'attenuation'
        'attenuation' or 'rsl'
    station : str, default 'BKLN'
        Mesonet station for official data
    window_days : int or None, default None
        Shortcut: sets both window_before and window_after to this many days.
        If provided, overrides window_before/window_after.
    window_before : str, default '1D'
        Time before event day start. Pandas offset string: '1D', '12H', '6H', '2D', etc.
    window_after : str, default '1D'
        Time after event day end. Pandas offset string: '1D', '12H', '6H', '2D', etc.
    max_events : int, optional
        Maximum number of events to plot
    figsize : tuple, optional
        Figure size
    cml_to_pws_map : dict, optional
        Mapping from CML IDs to PWS stations
    df_cml_meta : DataFrame, optional
        CML metadata for labels
    emphasize_cml_ids : list, optional
        CML IDs to highlight
    resample_interval : str, optional
        Time resampling interval (e.g., '15min', '1H')
    start_dt, end_dt : datetime, optional
        Custom time window (instead of event_days)
    panels : str or list, default 'all'
        Panels to show
    day_grid : bool, default True
        Show event day shading
    aggregate : str, optional
        Time aggregation interval (alias for resample_interval)
        Examples: '15min', '30min', '1H'
    cml_linewidth : float, default 2.5
        Line width for CML signals
    cml_linewidth_emphasized : float, default 4.0
        Line width for emphasized CMLs
    scatter : bool, default False
        Add a scatter panel: X = PWS precip (mm/h), Y = CML rain rate via power law (mm/h).
        Requires df_cml_meta with frequency and length columns.
    
    Examples
    --------
    # Single day - MUST use list []
    plot_event_day_analysis(df_cml_dict, [snowy_days[0]], all_params)
    
    # Multiple days
    plot_event_day_analysis(df_cml_dict, snowy_days[:3], all_params)
    
    # Time aggregation (15-min averages)
    plot_event_day_analysis(df_cml_dict, event_days, all_params, aggregate='15min')
    
    # Thicker lines
    plot_event_day_analysis(df_cml_dict, event_days, all_params, cml_linewidth=3.5)
    
    # No day grid (remove red shading)
    plot_event_day_analysis(df_cml_dict, event_days, all_params, day_grid=False)
    
    # Custom window: 6 hours before, 12 hours after the event day
    plot_event_day_analysis(df_cml_dict, event_days, all_params, window_before='6H', window_after='12H')
    
    # Symmetric 2-day window (shortcut)
    plot_event_day_analysis(df_cml_dict, event_days, all_params, window_days=2)
    """
    
    # Handle aggregate as alias for resample_interval
    if aggregate is not None:
        resample_interval = aggregate
    
    # Handle window_days shortcut (backward compat)
    if window_days is not None:
        window_before = f'{window_days}D'
        window_after = f'{window_days}D'
    
    # --- DETERMINE PLOTTING MODE ---
    time_limited_mode = (start_dt is not None and end_dt is not None)
    
    if time_limited_mode:
        start_dt = pd.to_datetime(start_dt)
        end_dt = pd.to_datetime(end_dt)
        plot_windows = [(start_dt, end_dt, None)]
        print(f"📅 Time-limited plot: {start_dt} → {end_dt}")
    else:
        if event_days is None:
            raise ValueError("Either provide event_days or both start_dt and end_dt")
        
        # Convert to list if single timestamp
        if isinstance(event_days, pd.Timestamp):
            event_days = [event_days]
        
        event_days = pd.to_datetime(event_days)
        if max_events:
            event_days = event_days[:max_events]
        
        td_before = pd.Timedelta(window_before)
        td_after = pd.Timedelta(window_after)
        
        plot_windows = []
        for event_day in event_days:
            w_start = event_day - td_before
            w_end = event_day + pd.Timedelta(days=1) + td_after
            plot_windows.append((w_start, w_end, event_day))
    
    # --- PARSE PANELS ---
    if panels == 'all':
        panel_list = ['cml', 'pcpn_pws', 'ptype', 'snow', 'temp', 'pcpn_official']
    elif isinstance(panels, str):
        panel_list = [panels]
    else:
        panel_list = list(panels)
    
    event_config = {
        'snow': {'color': 'red', 'emoji': '❄️', 'show_snow_depth': True},
        'rain': {'color': 'blue', 'emoji': '🌧️', 'show_snow_depth': False},
        'custom': {'color': 'gray', 'emoji': '📅', 'show_snow_depth': False},
    }
    config = event_config.get(event_type, event_config['custom'])
    
    if panels == 'all' and not config['show_snow_depth']:
        panel_list = [p for p in panel_list if p != 'snow']
    
    # Append scatter panel if requested
    if scatter and 'scatter' not in panel_list:
        panel_list.append('scatter')
    
    # Pre-compute power-law params once (shared across all windows)
    _pl_params = None
    if scatter and df_cml_meta is not None:
        _pl_params = _get_power_law_params_for_cmls(df_cml_dict, df_cml_meta)
        if len(_pl_params) > 0:
            ex = list(_pl_params.values())[0]
            print(f"✓ Power-law params for {len(_pl_params)} CMLs (e.g. f={ex['f_GHz']:.1f} GHz, a={ex['a']:.4f}, b={ex['b']:.3f})")
    
    n_rows = len(panel_list)
    
    if figsize is None:
        figsize = (26, 5.5 * n_rows)
    
    # --- EXTRACT DATA ---
    ptype_data = all_params.get('precip_type', {}) if all_params else {}
    snow_data = all_params.get('snow', {}) if all_params else {}
    snow_depth_data = all_params.get('snow_depth', {}) if all_params else {}
    temp_data = all_params.get('temp', {}) if all_params else {}
    precip_data = all_params.get('precip', {}) if all_params else {}
    
    pws_stations = _get_pws_stations_for_cmls(df_cml_dict, cml_to_pws_map)
    
    # --- CREATE PLOTS ---
    has_scatter = 'scatter' in panel_list
    
    for w_start, w_end, event_day in plot_windows:
        
        if has_scatter:
            # Don't share x-axis globally because scatter has different x
            fig, axes = plt.subplots(n_rows, 1, figsize=figsize)
            if n_rows == 1:
                axes = [axes]
            # Share x among time-series panels only (all except scatter)
            ts_axes = [axes[i] for i, p in enumerate(panel_list) if p != 'scatter']
            if len(ts_axes) > 1:
                for ts_ax in ts_axes[1:]:
                    ts_ax.sharex(ts_axes[0])
        else:
            fig, axes = plt.subplots(n_rows, 1, figsize=figsize, sharex=True)
            if n_rows == 1:
                axes = [axes]
        
        # Determine event_day for plotting (None if day_grid=False)
        plot_event_day = event_day if day_grid else None
        
        ax_idx = 0
        for panel_name in panel_list:
            ax = axes[ax_idx]
            
            if panel_name == 'cml':
                _plot_cml_signal(ax, df_cml_dict, w_start, w_end, plot_event_day, 
                                signal_type, config['color'], df_cml_meta=df_cml_meta,
                                emphasize_cml_ids=emphasize_cml_ids, 
                                resample_interval=resample_interval,
                                linewidth=cml_linewidth,
                                linewidth_emphasized=cml_linewidth_emphasized)
            
            elif panel_name == 'pcpn_pws':
                _plot_precip(ax, precip_data, w_start, w_end, plot_event_day,
                            station, 'pws', config['color'], 
                            pws_stations=pws_stations, resample_interval=resample_interval)
            
            elif panel_name == 'pcpn_official':
                _plot_precip(ax, precip_data, w_start, w_end, plot_event_day,
                            station, 'official', config['color'], 
                            resample_interval=resample_interval)
            
            elif panel_name == 'pcpn_merged':
                _plot_precip_merged(ax, precip_data, w_start, w_end, plot_event_day,
                                   station, config['color'], 
                                   pws_stations=pws_stations,
                                   resample_interval=resample_interval,
                                   official_alpha=official_alpha)
            
            elif panel_name == 'ptype':
                _plot_precip_type(ax, ptype_data, w_start, w_end, plot_event_day,
                                 config['color'])
            
            elif panel_name == 'temp':
                _plot_temperature(ax, temp_data, w_start, w_end, plot_event_day, 
                                 config['color'], resample_interval=resample_interval)
            
            elif panel_name == 'temp_ptype':
                _plot_temp_ptype_combined(ax, temp_data, ptype_data, w_start, w_end,
                                          plot_event_day, config['color'], 
                                          resample_interval=resample_interval)
            
            elif panel_name == 'snow':
                _plot_snow_depth(ax, snow_depth_data, w_start, w_end, plot_event_day,
                               station, snow_data, config['color'], 
                               all_params=all_params, resample_interval=resample_interval)
            
            elif panel_name == 'scatter':
                _plot_scatter_cml_vs_pws(ax, df_cml_dict, precip_data, w_start, w_end,
                                         event_day=plot_event_day, event_color=config['color'],
                                         signal_type=signal_type, df_cml_meta=df_cml_meta,
                                         pws_stations=pws_stations, cml_to_pws_map=cml_to_pws_map,
                                         resample_interval=resample_interval,
                                         pl_params=_pl_params, aligned_data=aligned_data)
            
            else:
                ax.text(0.5, 0.5, f'Unknown panel: {panel_name}', 
                       transform=ax.transAxes, ha='center', va='center')
            
            ax_idx += 1
        
        # Format x-axis on time-series panels (not scatter)
        ts_panel_indices = [i for i, p in enumerate(panel_list) if p != 'scatter']
        if ts_panel_indices:
            last_ts_ax = axes[ts_panel_indices[-1]]
            last_ts_ax.set_xlabel('Time', fontweight='bold', fontsize=label_size)
            last_ts_ax.xaxis.set_major_formatter(mdates.DateFormatter('%m-%d %H:%M'))
            plt.setp(last_ts_ax.xaxis.get_majorticklabels(), rotation=45, ha='right', fontsize=tick_size)
        
        # Apply font sizes to all axes
        for _ax in axes:
            _ax.tick_params(axis='both', labelsize=tick_size)
            # Boost ylabel / legend if they exist
            if _ax.get_ylabel():
                _ax.set_ylabel(_ax.get_ylabel(), fontsize=ylabel_size, fontweight='bold')
            leg = _ax.get_legend()
            if leg:
                for txt in leg.get_texts():
                    txt.set_fontsize(legend_size)
        
        # Title (optional)
        if show_title:
            agg_str = f' [agg={resample_interval}]' if resample_interval else ''
            if time_limited_mode:
                title = f'{config["emoji"]} {event_type.title()} Analysis{agg_str} - {start_dt.strftime("%Y-%m-%d %H:%M")} to {end_dt.strftime("%Y-%m-%d %H:%M")}'
            else:
                title = f'{config["emoji"]} {event_type.title()} Day Analysis{agg_str} - {event_day.strftime("%B %d, %Y (%A)")}'
            fig.suptitle(title, fontsize=label_size + 4, fontweight='bold')
        
        plt.tight_layout()
        plt.show()
        
        if event_day is not None:
            print(f"✓ {event_day.strftime('%Y-%m-%d')}")
        else:
            print(f"✓ {start_dt.strftime('%Y-%m-%d %H:%M')} → {end_dt.strftime('%Y-%m-%d %H:%M')}")
    
    # ------------------------------------------------------------------
    # STATISTICS (optional)
    # ------------------------------------------------------------------
    if statistics:
        all_stats = []
        
        for w_start, w_end, event_day in plot_windows:
            window_stats = {
                'window_start': w_start,
                'window_end': w_end,
                'event_day': event_day,
            }
            
            # --- Precipitation type breakdown ---
            ptype_src = ptype_data.get('asos_1min')
            if ptype_src is not None and len(ptype_src) > 0:
                pt_window = ptype_src.loc[w_start:w_end]
                if len(pt_window) > 0:
                    col = pt_window.columns[0]
                    pt_series = pt_window[col].dropna()
                    n_total = len(pt_series)
                    if n_total > 0:
                        counts = pt_series.value_counts()
                        ptype_pct = {}
                        for ptype in ['rain', 'snow', 'mix', 'dry', 'unknown']:
                            ptype_pct[ptype] = counts.get(ptype, 0) / n_total * 100
                        window_stats['precip_type_pct'] = ptype_pct
                        
                        print(f"\n{'='*60}")
                        print(f"PRECIP TYPE  ({w_start.strftime('%Y-%m-%d %H:%M')} → "
                              f"{w_end.strftime('%Y-%m-%d %H:%M')})")
                        print(f"{'='*60}")
                        for pt, pct in sorted(ptype_pct.items(), key=lambda x: -x[1]):
                            bar = '█' * int(pct / 2)
                            if pct > 0:
                                print(f"  {pt:>8s}: {pct:5.1f}%  {bar}")
                        print(f"  {'total':>8s}: {n_total} observations")
            
            # --- CML NaN % per link ---
            cml_nan_stats = {}
            for cml_key, df in df_cml_dict.items():
                if df is None or df.empty:
                    cml_nan_stats[cml_key] = 100.0
                    continue
                sig_col = signal_type if signal_type in df.columns else None
                if sig_col is None:
                    cml_nan_stats[cml_key] = 100.0
                    continue
                data = df.loc[w_start:w_end, sig_col]
                n_total = len(data)
                if n_total == 0:
                    cml_nan_stats[cml_key] = 100.0
                else:
                    n_nan = data.isna().sum()
                    cml_nan_stats[cml_key] = n_nan / n_total * 100
            
            window_stats['cml_nan_pct'] = cml_nan_stats
            
            print(f"\n{'='*60}")
            print(f"CML NaN %  ({w_start.strftime('%Y-%m-%d %H:%M')} → "
                  f"{w_end.strftime('%Y-%m-%d %H:%M')})")
            print(f"{'='*60}")
            for cml_key, nan_pct in sorted(cml_nan_stats.items(), key=lambda x: x[1]):
                bar = '█' * int((100 - nan_pct) / 2)
                status = '✓' if nan_pct < 10 else ('⚠' if nan_pct < 50 else '✗')
                
                # Include link metadata if available
                meta_str = ''
                if df_cml_meta is not None:
                    cml_id_str = str(cml_key.split('_')[0])
                    row = df_cml_meta[df_cml_meta['cml_id'].astype(str) == cml_id_str]
                    if len(row) > 0:
                        freq = row.iloc[0].get('frequency', None)
                        length = row.iloc[0].get('length', None)
                        if freq is not None and length is not None:
                            meta_str = f'  (f={freq:.0f}MHz, L={length:.0f}m)'
                
                print(f"  {status} {cml_key}: {nan_pct:5.1f}% NaN  "
                      f"({100 - nan_pct:.1f}% valid)  {bar}{meta_str}")
            
            all_stats.append(window_stats)
        
        return all_stats


