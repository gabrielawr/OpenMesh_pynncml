def _plot_precip(ax, precip_data, window_start, window_end, event_day, 
                 station='BKLN', sources='all', event_color='red',
                 pws_stations=None):
    """
    Plot precipitation.
    
    sources: 'all', 'official' (NOAA/Mesonet/ASOS), or 'pws'
    """
    
    if sources in ['all', 'official']:
        # Mesonet
        if 'mesonet' in precip_data:
            df = precip_data['mesonet']
            if station in df.columns:
                data = df[station].loc[window_start:window_end]
                if len(data) > 0:
                    ax.bar(data.index, data.values, width=0.003, color='green', 
                          alpha=0.7, label=f'Mesonet ({station})')
        
        # ASOS
        if 'asos_1min' in precip_data:
            df = precip_data['asos_1min']
            data = df.loc[window_start:window_end].mean(axis=1)
            if len(data) > 0:
                ax.bar(data.index, data.values, width=0.003, color='orange', 
                      alpha=0.8, label='ASOS (mean)')
    
    if sources in ['all', 'pws']:
        if 'pws' in precip_data:
            df = precip_data['pws']
            data = df.loc[window_start:window_end]
            
            # Filter to selected PWS stations if provided
            if pws_stations is not None and len(pws_stations) > 0:
                available_stations = [s for s in pws_stations if s in data.columns]
                if len(available_stations) > 0:
                    data = data[available_stations]
                else:
                    data = pd.DataFrame()  # No matching stations
            
            if len(data) > 0:
                # Plot individual stations (low intensity/alpha for overview)
                pws_colors = plt.cm.Set2(np.linspace(0, 1, len(data.columns)))
                for i, col in enumerate(data.columns):
                    ax.plot(data.index, data[col].values, 
                           color=pws_colors[i % len(pws_colors)],
                           linewidth=1, alpha=0.3, 
                           label=col if len(data.columns) <= 5 else None)
                
                # Plot mean/median lines (more prominent)
                mean_pws = data.mean(axis=1)
                median_pws = data.median(axis=1)
                n_stations = len(data.columns)
                ax.plot(mean_pws.index, mean_pws.values, 
                       color='purple', linewidth=2, alpha=0.8,
                       label=f'PWS Mean (n={n_stations})')
                ax.plot(median_pws.index, median_pws.values, 
                       color='darkviolet', linewidth=1.5, alpha=0.6, linestyle='--',
                       label=f'PWS Median (n={n_stations})')
    
    ax.axvspan(event_day, event_day + pd.Timedelta(days=1), alpha=0.15, color=event_color)
    
    title_map = {'all': 'All Sources', 'official': 'Official (NOAA/Mesonet)', 'pws': 'PWS'}
    ax.set_ylabel('Precip (mm)', fontweight='bold')
    ax.set_title(f'Precipitation ({title_map.get(sources, sources)})', fontweight='bold', loc='left')
    ax.grid(True, alpha=0.8)
    ax.legend(loc='upper right', fontsize=9)
    ax.set_ylim(0, 1)


def _get_day_stats(event_day, snow_depth_data, snow_data, station):
    """Get statistics for a day."""
    stats = []
    day_start = event_day.normalize()
    day_end = day_start + pd.Timedelta(days=1)
    
    mesonet = snow_depth_data.get('mesonet') if snow_depth_data else None
    if mesonet is not None and station in mesonet.columns:
        day_data = mesonet[station][(mesonet.index >= day_start) & (mesonet.index < day_end)]
        if len(day_data) > 0:
            stats.append(f'Mesonet: max={day_data.max():.1f}mm')
    
    if snow_data and 'noaa_daily' in snow_data:
        noaa = snow_data['noaa_daily']
        mask = noaa.index.normalize() == day_start
        if mask.any():
            val = noaa.loc[mask].mean().mean()
            stats.append(f'NOAA snow: {val:.1f}mm')
    
    return stats




