def _get_day_stats(event_day, snow_depth_data, snow_data, station):
    """Get statistics for a day."""
    stats = []
    day_start = event_day.normalize()
    day_end = day_start + pd.Timedelta(days=1)
    
    mesonet = snow_depth_data.get('mesonet') if snow_depth_data else None
    if mesonet is not None and station in mesonet.columns:
        day_data = mesonet[station][(mesonet.index >= day_start) & (mesonet.index < day_end)]
        if len(day_data) > 0:
            stats.append(f'Mesonet: max={day_data.max():.1f}mm')
    
    if snow_data and 'noaa_daily' in snow_data:
        noaa = snow_data['noaa_daily']
        mask = noaa.index.normalize() == day_start
        if mask.any():
            val = noaa.loc[mask].mean().mean()
            stats.append(f'NOAA snow: {val:.1f}mm')
    
    return stats


def _get_pws_stations_for_cmls(df_cml_dict, cml_to_pws_map):
    """Extract PWS stations matched to the CMLs in df_cml_dict."""
    if cml_to_pws_map is None:
        return None
    
    cml_ids = set()
    for key in df_cml_dict.keys():
        cml_id = str(key.split('_')[0])
        cml_ids.add(cml_id)
    
    relevant_pws = set()
    for cml_id in cml_ids:
        if cml_id in cml_to_pws_map:
            matches = cml_to_pws_map[cml_id]
        elif int(cml_id) in cml_to_pws_map:
            matches = cml_to_pws_map[int(cml_id)]
        else:
            continue
        
        if isinstance(matches, pd.DataFrame) and 'station_id' in matches.columns:
            relevant_pws.update(matches['station_id'].tolist())
    
    if len(relevant_pws) > 0:
        print(f"✓ Filtering PWS to {len(relevant_pws)} stations matched to {len(cml_ids)} CML links")
        return list(relevant_pws)
    return None


