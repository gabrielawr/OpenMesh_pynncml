def plot_precip_accumulation_dual(all_params, rainy_days, snowy_days, 
                                 start_date, end_date):
    """2 Figures: 1=Individual Sensors | 2=Means Only"""
    
    # === FIGURE 1: INDIVIDUAL SENSORS (כל התחנות) ===
    fig1, axes1 = plt.subplots(2, 2, figsize=(18, 12))
    
    # PWS - all sensors light
    ax = axes1[0,0]
    df_pws = all_params['precip']['pws'][start_date:end_date].clip(lower=0).cumsum()
    for col in df_pws.columns:
        ax.plot(df_pws.index, df_pws[col], 'lightblue', alpha=0.8, lw=0.5)
    ax.plot(df_pws.mean(1), 'blue', lw=3, label='Mean')
    ax.set_title('PWS - All Sensors + Mean')
    ax.grid(alpha=0.8)
    
    # ASOS 1min - all stations
    ax = axes1[0,1]
    df_asos = all_params['precip']['asos_1min'][start_date:end_date].clip(lower=0).cumsum()
    for col in df_asos.columns:
        ax.plot(df_asos.index, df_asos[col], lw=2.5, label=col)
    ax.set_title('ASOS 1min - All Stations')
    ax.legend()
    ax.grid(alpha=0.8)
    
    # NOAA Daily
    ax = axes1[1,0]
    df_noaa = all_params['precip']['noaa_daily'][start_date:end_date].clip(lower=0).cumsum()
    for col in df_noaa.columns:
        ax.plot(df_noaa.index, df_noaa[col], 'green', marker='o', lw=2.5, label=col)
    ax.set_title('NOAA Daily - All Stations')
    ax.legend()
    ax.grid(alpha=0.8)
    
    # Mesonet - all stations
    ax = axes1[1,1]
    df_mes = all_params['precip']['mesonet'][start_date:end_date].clip(lower=0).cumsum()
    colors = plt.cm.tab20.colors
    for i, col in enumerate(df_mes.columns):
        ax.plot(df_mes.index, df_mes[col], color=colors[i%len(colors)], lw=1.5, alpha=0.8)
    ax.set_title('Mesonet - All Sensors')
    ax.grid(alpha=0.8)
    
    plt.suptitle('PRECIPITATION ACCUMULATION - INDIVIDUAL SENSORS', fontsize=16)
    plt.tight_layout()
