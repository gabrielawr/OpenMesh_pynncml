   "source": [
    "Rain Estimation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "0b17f21d",
   "metadata": {},
   "outputs": [],
   "source": [
    "# @title Rain Estimation Hyper-parameters\n",
    "wa_factor = 1  # @param{\"type\": \"number\"}\n",
    "r_min = 0.8  # @param{\"type\": \"number\"}\n",
    "dynamic_baseline_window_size = 4  # @param{\"type\": \"integer\"}\n",
    "statistics_window_size = 15\n",
    "statistics_wet_dry_threshold = 0.55\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "430dc424",
   "metadata": {},
   "outputs": [],
   "source": [
    "tsc = pnc.scm.rain_estimation.two_step_constant_baseline(pnc.scm.power_law.PowerLawType.MAX, r_min,\n",
    "                                                         statistics_window_size, statistics_wet_dry_threshold,\n",
    "                                                         wa_factor=wa_factor)\n",
    "os_baseline = pnc.scm.rain_estimation.one_step_dynamic_baseline(pnc.scm.power_law.PowerLawType.MAX, r_min,\n",
    "                                                                dynamic_baseline_window_size, 1)\n",
    "\n",
    "att = linkmm.attenuation()\n",
    "rain_ts, wd, ts_baseline_res = tsc(att,\n",
    "                               linkmm.meta_data)  # run constant baseline\n",
    "rain_os, os_baseline_res = os_baseline(att,\n",
    "                                   linkmm.meta_data)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "4f1e52bc",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1500x500 with 3 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "_, axs = plt.subplots(1, 3, figsize=(15, 5))\n",
    "axs[0].plot(ts_baseline_res.numpy().flatten(), label=\"Constant Baseline\")\n",
    "axs[0].plot(os_baseline_res.numpy().flatten(), label=\"Dynamic Baseline\")\n",
    "axs[0].set_xlabel(\"Time index\")\n",
    "axs[0].set_ylabel(\"Baseline [dB]\")\n",
    "axs[0].grid()\n",
    "axs[0].legend()\n",
    "\n",
    "axs[1].plot(att[0,:,0].numpy().flatten(), label=r\"$A_{k}^{max}$\")\n",
    "axs[1].plot(att[0,:,1].numpy().flatten(), label=r\"$A_{k}^{min}$\")\n",
    "axs[1].set_xlabel(\"Time index\")\n",
    "axs[1].set_ylabel(\"CML Attenuation [dB]\")\n",
    "axs[1].grid()\n",
    "axs[1].legend()\n",
    "\n",
    "axs[2].plot(np.maximum(att[0,:,0].numpy().flatten()-ts_baseline_res.numpy().flatten(),0), label=r\"$A_{k}^{max}-BL_{TS}$\")\n",
    "axs[2].plot(np.maximum(att[0,:,0].numpy().flatten()-os_baseline_res.numpy().flatten(),0), label=r\"$A_{k}^{min}-BL_{OS}$\")\n",
    "axs[2].set_xlabel(\"Time index\")\n",
    "axs[2].set_ylabel(\"CML Attenuation [dB]\")\n",
    "axs[2].grid()\n",
    "axs[2].legend()\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
