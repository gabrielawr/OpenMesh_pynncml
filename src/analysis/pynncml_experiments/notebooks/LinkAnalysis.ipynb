   "source": [
    "rain_ts_flat = np.nan_to_num(rain_ts.numpy().flatten(), nan=0.0)\n",
    "rain_os_flat = np.nan_to_num(rain_os.numpy().flatten(), nan=0.0)\n",
    "\n",
    "plt.plot(np.nancumsum(linkmm.gauge_ref[0].data_array), label=\"Reference\")\n",
    "plt.plot(np.cumsum(rain_ts_flat), label=\"Constant Baseline\")\n",
    "plt.plot(np.cumsum(rain_os_flat), label=\"Dynamic Baseline\")\n",
    "plt.xlabel(\"Time index\")\n",
    "plt.ylabel(\"Accumulate Rain [mm]\")\n",
    "plt.grid()\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
